{{- /* The git signing public key as a bare `ssh-ed25519 AAAA…` string, from
       Proton Pass, falling back to the agent. Renders empty if neither answers,
       and config.tmpl then omits user.signingkey so commits fail loudly.

       Both calls must stay guarded: protonPass aborts the entire template when
       pass-cli fails, and `output` does the same on a non-zero exit.

       Addressed by vault name and item title, not by share/item id. A PAT
       session's vault access is a share, so re-authenticating mints a new
       share id and any id pinned here goes stale — which fails as a 422 that
       aborts the whole apply, not just this file. Titles survive that, and
       are how the restore script and secrets-check already name items. */ -}}
{{- if eq (includeTemplate "has-proton-session" .) "true" -}}
{{- protonPass "pass://Dotfiles/git signing key/public_key" | trim -}}
{{- else -}}
{{- output "sh" "-c" "ssh-add -L 2>/dev/null | awk '/git-signing/{print $1\" \"$2; exit}'" | trim -}}
{{- end -}}
