{{- protonPass "pass://HKQ0vUtADZgZYVg9bUWhhCWiTtGr3BN2EthtEvJIc_odo0SO-m8j2pQ3sHDqQqZ3XMo6q5E6KuybcW0LmLbm8Q==/oeoBEx8LHV1-NOk3sJuaYe56ocAn1DWxArqQKMYHdWqkkHm31pV4ZYCU2prvp-jdiVD_5oAOBBR8F4kE1BfoDA==/public_key" | trim -}}
{{- else -}}
{{- output "sh" "-c" "ssh-add -L 2>/dev/null | awk '/git-signing/{print $1\" \"$2; exit}'" | trim -}}
{{- end -}}
