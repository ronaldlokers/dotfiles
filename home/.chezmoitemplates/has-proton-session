{{- /* "true" or "false": can we read Proton Pass right now? Same convention
       as is-container. lookPath returns "" when pass-cli is absent (containers,
       first apply). The sh wrapper is required — chezmoi's `output` aborts the
       whole template on a non-zero exit. */ -}}
{{- if lookPath "pass-cli" -}}
{{- output "sh" "-c" "pass-cli info >/dev/null 2>&1 && echo true || echo false" | trim -}}
{{- else -}}false{{- end -}}
