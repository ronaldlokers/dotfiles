#!/bin/sh
# Start the Nano Banana MCP server with the Gemini key in its environment and
# nowhere else.
#
# Named gemini-image-mcp rather than nanobanana-mcp because the package ships an
# executable of its own by that second name. Both landed on PATH, mise's shim
# won, and `nanobanana-mcp` therefore started the server with no key at all —
# a wrapper that exists and is never the thing that runs.
#
# The key could have gone straight into ~/.claude.json as an `-e` value on
# `claude mcp add`. It is not there because that file is not chezmoi-managed,
# is world-readable by default, and gets copied around when a Claude Code
# problem is being diagnosed. It also could have been exported from the shell
# rc, which would hand it to every process this user starts rather than to the
# one that needs it.
#
# So: one file at 0600 that restore-secrets writes from Proton Pass, read here
# and inherited only by the server.
set -eu

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/nanobanana/env"

if [ ! -r "$env_file" ]; then
	echo "gemini-image-mcp: no key at $env_file." >&2
	echo "gemini-image-mcp: add 'gemini api key' to the Dotfiles vault in Proton Pass," >&2
	echo "gemini-image-mcp: with the key as the item's note, then 'chezmoi apply'." >&2
	exit 1
fi

# The file holds the key and nothing else, so the shell never sees it as code.
GEMINI_API_KEY="$(cat "$env_file")"
export GEMINI_API_KEY

if [ -z "$GEMINI_API_KEY" ]; then
	echo "gemini-image-mcp: $env_file is empty." >&2
	exit 1
fi

# The vault item is created before the key exists, so that adding the key is
# pasting into a field rather than getting a title exactly right in a password
# manager. That placeholder then restores like any other secret, and without
# this the server would start with it and fail somewhere inside Google's SDK
# on the first render — an opaque failure where a plain one had been.
if [ "$GEMINI_API_KEY" = "REPLACE-ME-WITH-THE-GEMINI-API-KEY" ]; then
	echo "gemini-image-mcp: the vault item still holds its placeholder." >&2
	echo "gemini-image-mcp: put the real key in the note of 'gemini api key'" >&2
	echo "gemini-image-mcp: in the Dotfiles vault, then 'chezmoi apply'." >&2
	exit 1
fi

# Where the images land. Under the user's pictures rather than in whatever
# directory Claude Code happened to start in, because a generated image is a
# file the user will want to find again.
IMAGE_OUTPUT_DIR="${IMAGE_OUTPUT_DIR:-$HOME/Pictures/nanobanana}"
export IMAGE_OUTPUT_DIR
mkdir -p "$IMAGE_OUTPUT_DIR"

exec nanobanana-mcp-server "$@"
