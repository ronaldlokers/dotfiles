#!/bin/sh
# Load the SSH keys held in Proton Pass into the running ssh-agent; they never
# touch disk. Called by dot_config/shell/ssh-agent.sh when the agent is empty,
# and safe to run by hand — reloading is a no-op.
set -eu

usage() {
	cat <<'USAGE'
usage: proton-ssh-load [--quiet] [--prompt]

Loads the SSH keys held in the Proton Pass Dotfiles vault into the running
ssh-agent. The keys never touch disk. Reloading is a no-op, so this is safe to
run by hand.

  --quiet    say nothing on success
  --prompt   ask for the bootstrap token when there is no session and a
             terminal to ask on. Only the apply path passes this: the shell rc
             must not, or every new terminal with an empty agent would block.
  --timeout SECS
             bound on each pass-cli call, not on the run (default 30). A call
             that hits it means Proton is unreachable, and the run stops there.
             The shell rc asks for a much shorter one — it is on the path
             between pressing the terminal key and getting a prompt.
USAGE
}

quiet=0
prompt=0

# Every pass-cli call here is a network round trip, and on the shell rc's path
# there are three: `info`, the `login` from the cached token, and the
# `ssh-agent load` itself. None had a bound of its own, so a Proton that was
# down, a captive portal or a half-up VPN stalled *every new terminal* for as
# long as the TCP stack cared to wait, with nothing on screen to say why.
#
# 30s by default, which is for a person who typed the command and can see it
# working; the shell rc passes something far shorter, because nobody opening a
# terminal is waiting on their SSH keys.
pc_timeout=30
while [ "$#" -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--quiet) quiet=1 ;;
	# Only the apply path passes this. The shell rc must not, or every new
	# terminal with an empty agent would block on the prompt.
	--prompt) prompt=1 ;;
	--timeout)
		# Checked before shifting, the same way secrets-check checks --source:
		# `shift 2` past the end is a shell error ("shift count out of range"),
		# not this script's usage message.
		if [ "$#" -lt 2 ]; then
			usage >&2
			exit 2
		fi
		case "$2" in
		'' | *[!0-9]*)
			echo "proton-ssh-load: --timeout wants whole seconds: $2" >&2
			usage >&2
			exit 2
			;;
		esac
		pc_timeout="$2"
		shift
		;;
	*)
		echo "proton-ssh-load: unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

say() {
	[ "$quiet" = 1 ] || echo "$@"
}

# The one thing --quiet must not swallow, said at most once per boot.
#
# Two requirements pull opposite ways here. The shell rc calls this on every new
# terminal that finds an empty agent, and passes --quiet so a successful load
# does not print at every prompt — a line per terminal is noise nobody reads.
# But a terminal where ssh silently has no keys, saying nothing about why, is
# how you end up debugging a push instead of running one command.
#
# So: the first terminal after a session dies explains itself, and every
# terminal after that stays quiet. The marker lives in $XDG_RUNTIME_DIR, which
# is per-boot and cleared by the OS — no cleanup to get wrong, and a reboot
# earns the message again, which is right, because a reboot is exactly when you
# have forgotten. Where there is no runtime dir (a container, a stripped
# environment) the message simply always prints; those callers are not the shell
# rc and are not on a per-prompt path.
#
# stderr, so it stays out of anything capturing this script's output.
# $1 is a marker name, and it is not decoration. One marker for every message
# meant that whichever fault happened first silenced the others for the rest of
# the boot: a terminal that reported "no session" left a later, different
# failure — a rejected token, keys that would not load — with nothing to say.
# They are separate conditions with separate fixes, so they get separate
# markers and each is allowed to speak once.
warn_once() {
	_warn_key="$1"
	shift
	_warn_dir="${XDG_RUNTIME_DIR:-}"
	if [ -n "$_warn_dir" ] && [ -d "$_warn_dir" ]; then
		_warn_marker="$_warn_dir/proton-ssh-load.warned.$_warn_key"
		# Already told you this one this boot. Say nothing.
		[ -e "$_warn_marker" ] && return 0
		# Best effort: a marker we cannot write means the message repeats,
		# which is the safe direction to fail in.
		: >"$_warn_marker" 2>/dev/null || true
	fi
	while [ $# -gt 0 ]; do
		echo "$1" >&2
		shift
	done
}

# Where `timeout` is absent the calls run unbounded and the caller's patience is
# the only backstop — which is where this started, so nothing is lost by
# degrading to it.
if command -v timeout >/dev/null 2>&1; then
	pc() { timeout "$pc_timeout" pass-cli "$@"; }
else
	pc() { pass-cli "$@"; }
fi

# 124 is timeout(1)'s "I killed it", and it is worth telling apart from every
# other failure: a call that never got an answer has not been refused. Nothing
# is retired, nothing is re-asked, and the run stops rather than spending the
# same wait again on the next call — a Proton that did not answer the first
# question will not answer the second, and the point of the exercise is a shell
# that comes up.
unreachable() {
	warn_once unreachable \
		"proton-ssh-load: Proton Pass did not answer within ${pc_timeout}s — your SSH keys are not loaded." \
		"proton-ssh-load: run 'proton-ssh-load' by hand once the network is back."
	exit 0
}

command -v pass-cli >/dev/null 2>&1 || {
	say "proton-ssh-load: pass-cli is not installed"
	exit 0
}

# Containers get keys from the forwarded agent instead. Asked here at run time
# rather than gated at apply time by .chezmoitemplates/is-container, because
# this script also runs from the source tree inside a devcontainer working on
# this repo. Same two markers as the template; `mise run lint` asserts that.
if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
	exit 0
fi

# The vault this machine's secrets live in. chezmoi writes the name to
# machine.env, because this script is not a template and cannot ask the profile
# set itself. Absent, unreadable or empty means the personal vault: the secret
# restore runs from the same apply that writes that file, so a machine part-way
# through its first bootstrap genuinely has no copy yet, and asking Proton for
# items in a vault named "" would report every one of them missing.
machine_env="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/machine.env"
if [ -r "$machine_env" ]; then
	# shellcheck source=/dev/null
	. "$machine_env"
fi
vault="${DOTFILES_VAULT:-Dotfiles}"
[ -n "$vault" ] || vault="Dotfiles"
pat_file="$HOME/.config/pass-cli-bootstrap-pat"

# ask_pat assigns here; declared up front because it is also the flow's
# working variable.
pat=""
asked=0

# Ask for the token on the terminal. Deliberately ignores --quiet: the apply
# path passes it, and a hang with no visible question is worse than noise.
# Refuses without --prompt so the shell rc never blocks a new terminal, and
# without a tty so `chezmoi apply </dev/null` (CI, devpod) never blocks either.
# /dev/tty is readable even when stdin is redirected, so `-t 0` is the gate and
# stdin is what gets read.
ask_pat() {
	[ "$prompt" = 1 ] || return 1
	[ -t 0 ] || return 1
	# One prompt per run: no retry loop.
	[ "$asked" = 0 ] || return 1
	asked=1

	# Echo off before anything is printed: the stty -g failure path just below
	# can therefore never leave a dangling prompt, and there is no window
	# between printing the prompt and disabling echo. Known limitation, left
	# open deliberately: both callers of ask_pat are preceded by a network
	# round trip to Proton — pass-cli info before the first call, pass-cli
	# login (in try_login) before the retry below — and each one runs before
	# ask_pat is even entered, so a paste that lands during either round trip
	# is echoed by the tty driver like any other typing before this point —
	# closing that window is out of scope here. Restored on interrupt too —
	# a Ctrl-C here would otherwise leave the terminal with no echo at all.
	stty_save="$(stty -g 2>/dev/null)" || return 1
	trap 'stty "$stty_save" 2>/dev/null; printf "\n" >&2' INT TERM HUP
	# A suspend (Ctrl-Z) leaves the tty echo off, but the interactive shell
	# that reclaims the terminal turns echo back on for itself. This trap
	# does not make the prompt resume afterward: in this shell, catching
	# TSTP or CONT aborts the blocked `read` immediately (verified: it
	# returns nonzero right away, never with a typed value), so a suspend
	# here always cancels this prompt attempt outright rather than pausing
	# and continuing it on `fg`. What the trap buys is narrower but real: it
	# re-asserts echo-off in that same instant, so the read can never be
	# aborted (or, in principle, resumed) with echo left on.
	trap 'stty -echo 2>/dev/null || true' TSTP CONT
	stty -echo 2>/dev/null || true

	if [ -n "${1:-}" ]; then
		printf '%s\n' "$1" >&2
	fi
	printf 'Proton Pass PAT (Dotfiles vault, item "bootstrap PAT"): ' >&2

	pat=""
	# read returns non-zero at EOF, which set -e would take as fatal.
	read -r pat || true
	# Clear the TSTP/CONT trap before restoring stty: otherwise a suspend or
	# resume signal landing in the gap between the two would re-assert
	# echo-off with nothing left to undo it, leaving the terminal echo-less
	# after this function — and the script — has already exited.
	trap - INT TERM HUP TSTP CONT
	stty "$stty_save" 2>/dev/null || true
	printf '\n' >&2

	[ -n "$pat" ]
}

# Never as --personal-access-token: a flag value is visible in `ps`.
#
# The exit code is captured rather than returned directly so a timeout can be
# told apart from a refusal here, where the caller cannot: "that token was
# rejected" retires the cached copy and re-asks, and an outage must do neither.
try_login() {
	_tl_rc=0
	PROTON_PASS_PERSONAL_ACCESS_TOKEN="$1" pc login >/dev/null 2>&1 || _tl_rc=$?
	if [ "$_tl_rc" = 124 ]; then
		unreachable
	fi
	return "$_tl_rc"
}

# Authenticate if the session lapsed. Token comes from the environment on a
# fresh machine and is cached at $pat_file after. Passed via the environment,
# never as --personal-access-token, whose value shows up in `ps`.
info_rc=0
pc info >/dev/null 2>&1 || info_rc=$?
if [ "$info_rc" = 124 ]; then
	unreachable
fi
if [ "$info_rc" -ne 0 ]; then
	pat="${PROTON_PASS_PERSONAL_ACCESS_TOKEN:-}"
	cache_it=1
	# Whether the token under test came out of the cache, which is the only
	# case where this script has anything to retire on rejection.
	from_cache=0
	if [ -z "$pat" ] && [ -r "$pat_file" ]; then
		pat="$(cat "$pat_file")"
		cache_it=0
		from_cache=1
	fi

	# Nothing to go on: ask, if this caller is allowed to.
	if [ -z "$pat" ]; then
		if ask_pat; then
			cache_it=1
		fi
	fi

	if [ -z "$pat" ]; then
		warn_once no-session \
			"proton-ssh-load: no Proton Pass session — your SSH keys are not loaded." \
			"proton-ssh-load: run 'pass-cli login', or set" \
			"proton-ssh-load: PROTON_PASS_PERSONAL_ACCESS_TOKEN (Dotfiles vault," \
			"proton-ssh-load: item 'bootstrap PAT') and run this again."
		exit 0
	fi

	if ! try_login "$pat"; then
		# A cached token Proton has refused is not going to start working, and
		# leaving it in place means every new terminal for the rest of time
		# presents the same dead credential and gets the same answer. Retire it.
		#
		# Renamed, not deleted, and the difference is the whole reason this is
		# safe to do at all. `pass-cli login` failing does not distinguish "this
		# token is revoked" from "Proton was unreachable for ten seconds", and
		# deleting on the second would destroy the one thing that makes
		# unattended applies work — on a machine that, by construction, cannot
		# read the vault to get another copy. Moving it aside stops the retry
		# loop while keeping the value recoverable by hand.
		#
		# Only when it came from the cache: a token supplied through the
		# environment is the caller's to manage, and the cache may hold a
		# perfectly good one that this run never even looked at.
		if [ "$from_cache" = 1 ]; then
			if mv -f "$pat_file" "$pat_file.rejected" 2>/dev/null; then
				chmod 600 "$pat_file.rejected" 2>/dev/null || true
				say "proton-ssh-load: retired the cached token to ${pat_file#"$HOME"/}.rejected"
			fi
		fi

		# The token we had was rejected. One more chance on a terminal: this is
		# how a token rotated in the vault heals itself on the next interactive
		# apply. ask_pat prints the notice only when it is actually going to
		# prompt, so the shell-rc path stays silent.
		pat=""
		if ask_pat "proton-ssh-load: that token was rejected." &&
			try_login "$pat"; then
			cache_it=1
		else
			warn_once rejected "proton-ssh-load: could not authenticate to Proton Pass — your SSH keys are not loaded."
			exit 0
		fi
	fi

	# Only after a successful login, so a rejected token never replaces a
	# working cached one.
	if [ "$cache_it" = 1 ]; then
		mkdir -p "$(dirname "$pat_file")"
		pat_tmp="$pat_file.tmp.$$"
		if (
			umask 077
			printf '%s\n' "$pat" >"$pat_tmp"
		) && mv -f "$pat_tmp" "$pat_file"; then
			# mv within one directory is rename(2): it replaces the inode
			# outright, so a pre-existing file's mode cannot survive it. Kept
			# anyway as an explicit, self-documenting guarantee that this
			# file is 600 regardless of how it got written.
			chmod 600 "$pat_file"
			say "proton-ssh-load: cached the token at ${pat_file#"$HOME"/}"
		else
			# A partial write or a failed rename must not leave a plaintext
			# token sitting in a *.tmp.* file forever.
			rm -f "$pat_tmp"
		fi
	fi
	unset pat
fi

# --quiet means "say nothing on success", and this line read it as "say nothing".
# Every path above earns its way to a warn_once when it cannot deliver keys;
# this one — the call that actually loads them — sent its failure to /dev/null
# and exited 0. So the single most direct way to end up with an empty agent,
# a session that is alive and a load that fails, was the one failure the shell
# rc could never report. That is the state where you go and debug a git push.
#
# Same rule as the rest: once per boot, on stderr, and the successful case stays
# silent so a working terminal prints nothing.
if [ "$quiet" = 1 ]; then
	load_rc=0
	load_err="$(pc ssh-agent load --vault-name "$vault" 2>&1 >/dev/null)" || load_rc=$?
	if [ "$load_rc" = 124 ]; then
		unreachable
	fi
	if [ "$load_rc" -ne 0 ]; then
		warn_once load-failed \
			"proton-ssh-load: the Proton Pass session is alive but loading the SSH keys failed." \
			"proton-ssh-load: run 'proton-ssh-load' by hand to see why."
		# The error text itself is not printed here. It is pass-cli's, arbitrary
		# in length, and this runs at every new prompt — the one-line pointer to
		# a command that shows it in full is what belongs on a shell startup
		# path. Kept in a variable rather than discarded so a future caller can
		# use it without re-running the load.
		: "${load_err:-}"
		exit 0
	fi
else
	# Bounded here too, and a timeout says the same thing it says everywhere
	# else rather than surfacing as a bare exit 124 nobody can read.
	load_rc=0
	pc ssh-agent load --vault-name "$vault" || load_rc=$?
	if [ "$load_rc" = 124 ]; then
		unreachable
	fi
	if [ "$load_rc" -ne 0 ]; then
		exit "$load_rc"
	fi
fi
