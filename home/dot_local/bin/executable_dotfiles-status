#!/bin/sh
# One command that answers "is anything wrong with this machine's secrets?".
#
# The pieces existed; the answer did not. A failing weekly check raises a
# desktop toast, which is gone the moment you look away and never appears at all
# when the timer fires outside a graphical login. It marks the unit failed,
# which is durable but only answers "did the last run fail" — and a unit that
# has stopped running altogether is, from `systemctl --user --failed`, exactly
# indistinguishable from one that runs and passes. Both are absent.
#
# That is the gap this closes: not "did the check fail" but "when did the check
# last actually run, and what did it say". A timer that was disabled by a
# botched apply, a machine that has been off for a month, a unit whose
# ExecStart moved — all of them look like health until someone asks.
#
# Reads recorded state only. It never contacts Proton, never reads a secret and
# never writes anything, so it is instant and safe to put in a prompt or run in
# a loop. Run `dotfiles-secrets-check` for the live answer.
set -eu

usage() {
	cat <<'USAGE'
usage: dotfiles-status [--quiet]

Reports what is recorded about this machine's secrets health: when the weekly
check last ran and what it found, and when the offline backup was last made.

Reads local state only — no network, no vault, no secrets. Run
`dotfiles-secrets-check` for a live answer.

  --quiet   print nothing unless something is *broken*; exit status is the
            answer. Warnings are deliberately silent here — they are for a
            human who typed this command, not for something that will notify
            you about them daily.

Exits 1 when something is broken, 0 otherwise (including with warnings).
USAGE
}

quiet=0
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--quiet) quiet=1 ;;
	*)
		echo "dotfiles-status: unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

# Containers get nothing from Proton by design, so every *producer* of the two
# files below is kept out of one by .chezmoiignore. This is the sole consumer
# and it was the only member of the family with no gate — inside a devpod it
# printed two faults and told you to run `systemctl --user status` (no manager)
# and `dotfiles-secrets-export` (not installed). Same two markers as
# .chezmoitemplates/is-container; `mise run lint` asserts the lists stay in step.
if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
	exit 0
fi

# The same facts file the secrets scripts read, for the same reason: this is not
# a template and cannot ask the profile set itself. Unset means personal, which
# is what every machine was before the split.
machine_env="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/machine.env"
if [ -r "$machine_env" ]; then
	# shellcheck source=/dev/null
	. "$machine_env"
fi
case "${DOTFILES_PROFILES:- personal }" in
*" personal "*) is_personal=1 ;;
*) is_personal=0 ;;
esac

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
check_status="$state_dir/last-check"
backup_manifest="$state_dir/secrets-backup"

# The weekly timer plus its 12h randomised delay means a healthy machine can
# legitimately be eight days between runs. Ten is the threshold: late enough
# not to cry wolf over a laptop that was shut for a long weekend, early enough
# that a timer which has stopped firing is noticed within a fortnight.
stale_days=10

# Faults and warnings are different exit codes because they are different
# requests. A fault means "something is broken now" and is what the daily timer
# notifies on. A warning means "worth knowing when you look" and must not
# interrupt: the offline copy that has never been made is the case that proved
# it, since it produced an identical unactionable toast every day for a
# condition that needs physical media to resolve.
#
# So --quiet is fault-only, deliberately. Warnings are for a human who typed
# this command.
#
# The tier is carried by the line prefix and by rc, not by a state variable:
# a warning says `warn` and leaves rc alone, a fault says `FAIL` and sets it.
# There is deliberately nothing to keep in sync between the two.
rc=0
out=""

# Collected rather than printed directly, so --quiet can decide at the end
# whether any of it was worth saying.
say() {
	out="$out$1
"
}

now_epoch="$(date -u +%s 2>/dev/null || echo 0)"

# Whole days between an ISO-8601 UTC timestamp and now. Prints nothing if the
# date cannot be parsed, which the caller treats as "unknown" rather than 0 —
# an unparsable date must not read as "checked today".
# Whole days between an ISO-8601 UTC timestamp and now. Fails — rather than
# answering — for anything it cannot trust, and the caller treats that as
# "unknown", never as 0.
#
# The empty-string guard is the important one and it is not defensive
# programming: `date -u -d "" +%s` *succeeds* on GNU coreutils, returning
# today's midnight. So a record missing its date line parsed cleanly as
# "checked today", permanently and silently — in the one mechanism that exists
# to notice a weekly check which has stopped running. The comment here used to
# say an unparsable date must not read as today. It did.
#
# A future date is rejected for the same reason rather than reported as a
# negative age: clock skew at boot, before NTP has synced and while a
# Persistent=true timer is firing, is exactly when this would silently answer
# "fine" forever.
days_since() {
	[ -n "$1" ] || return 1
	case "$1" in
	*[!0-9TZ:.+-]*) return 1 ;;
	esac
	_ds_epoch="$(date -u -d "$1" +%s 2>/dev/null || true)"
	[ -n "$_ds_epoch" ] || return 1
	[ "$now_epoch" -gt 0 ] || return 1
	_ds_days=$(((now_epoch - _ds_epoch) / 86400))
	# Dated in the future: not a smaller age, an untrustworthy record.
	[ "$_ds_days" -ge 0 ] || return 1
	echo "$_ds_days"
}

# --- the weekly check --------------------------------------------------------

if [ ! -f "$check_status" ]; then
	say "FAIL  secrets check     has never recorded a run on this machine"
	say "      Either it has never run, or the timer was never enabled."
	say "      Check with: systemctl --user status dotfiles-secrets-check.timer"
	rc=1
else
	when="$(sed -n 's/^date=//p' "$check_status" | head -1)"
	result="$(sed -n 's/^result=//p' "$check_status" | head -1)"
	detail="$(sed -n 's/^detail=//p' "$check_status" | head -1)"
	age_days="$(days_since "$when" || true)"

	if [ -z "$age_days" ]; then
		say "FAIL  secrets check     the recorded date is unreadable ($when)"
		rc=1
	elif [ "$age_days" -gt "$stale_days" ]; then
		# The finding this exists for. Not "the check failed" — the check has
		# not run, which nothing else on the machine would ever tell you.
		say "FAIL  secrets check     last ran $age_days days ago; the weekly timer is not firing"
		say "      Check with: systemctl --user status dotfiles-secrets-check.timer"
		rc=1
	else
		case "$result" in
		ok)
			say "ok    secrets check     $age_days day(s) ago: $detail"
			;;
		warn)
			say "warn  secrets check     $age_days day(s) ago: $detail"
			say "      Run 'dotfiles-secrets-check' for the detail."
			;;
		*)
			say "FAIL  secrets check     $age_days day(s) ago: ${detail:-failed}"
			say "      Run 'dotfiles-secrets-check' for the detail."
			rc=1
			;;
		esac
	fi
fi

# --- the offline copy --------------------------------------------------------
#
# No staleness threshold here on purpose, and it is the same reasoning the check
# itself uses: an untouched key means a two-year-old copy is still a perfectly
# good copy, and nagging about its age would only teach you to ignore the line.
# What matters is whether one exists at all.
if [ "$is_personal" != 1 ]; then
	# A work machine has no age key to copy: the Work vault holds none, the
	# export script is not installed there, and the weekly check skips this half
	# too. Saying nothing is the honest answer — the alternative is a warn line
	# on every run about a copy that can never be made, which is exactly the
	# noise the warn tier exists to avoid.
	:
elif [ ! -f "$backup_manifest" ]; then
	# A warning, not a fault, and the distinction is the whole reason the two
	# tiers exist. This condition has been true since the machine was built, it
	# needs a USB stick physically present to resolve, and as a fault it
	# produced one identical toast per day forever — in the same channel as
	# every real failure. That is how a channel stops being read. It says so
	# every time a human looks, and stays out of the way otherwise.
	say "warn  offline backup    none has ever been recorded"
	say "      Proton is otherwise the only copy. Run: dotfiles-secrets-export <destination>"
else
	backup_when="$(sed -n 's/^date=//p' "$backup_manifest" | head -1)"
	backup_dest="$(sed -n 's/^destination=//p' "$backup_manifest" | head -1)"
	backup_age="$(days_since "$backup_when" || true)"
	if [ -n "$backup_age" ]; then
		say "ok    offline backup    made $backup_age day(s) ago: ${backup_dest:-unknown destination}"
	else
		say "ok    offline backup    recorded: ${backup_dest:-unknown destination}"
	fi
	# Whether it still *reads back* is a question only the passphrase can
	# answer, so this points at the command rather than pretending to know.
	# Quoted: a removable-media path with a space in it (/run/media/you/My
	# Stick) is entirely ordinary, and this line is meant to be pasted.
	say "      Verify it reads back: dotfiles-secrets-restore '${backup_dest:-<file>}'"
fi

if [ "$quiet" = 1 ] && [ "$rc" -eq 0 ]; then
	exit 0
fi

printf '%s' "$out"
exit "$rc"
