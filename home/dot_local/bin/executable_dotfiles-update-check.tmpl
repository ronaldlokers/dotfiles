#!/bin/bash
# Notify when the dotfiles repo has commits this machine hasn't applied.
#
# Read-only by design: fetch and compare, never pull, never apply. Run from
# dotfiles-update-check.timer, and safe to run by hand.
set -euo pipefail

usage() {
	cat <<'EOF'
usage: dotfiles-update-check

Notifies when the dotfiles repo has commits this machine hasn't applied. Fetches
and compares; never pulls, never applies. Silent when there is nothing to say.

Takes no options. Run from dotfiles-update-check.timer, and safe to run by hand.
EOF
}

# Took no arguments before, so `--help` reached the network and ran a fetch
# instead of printing this. Same correction as repos-sync next door.
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "dotfiles-update-check: unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
done

source_dir="{{ .chezmoi.sourceDir }}"

# Every early exit is 0. This runs unattended on a timer, and "no network" or
# "not a git checkout" are ordinary states, not failures worth logging as such.
#
# A literal "$source_dir/.git" check would break under .chezmoiroot: source_dir
# is the chezmoiroot subdirectory, while .git lives at the repo root above it.
# Ask git instead — it walks up from $source_dir to find the enclosing repo.
command -v git >/dev/null 2>&1 || exit 0
git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

branch="$(git -C "$source_dir" symbolic-ref --short -q HEAD || true)"
[ -n "$branch" ] || exit 0   # detached HEAD: nothing meaningful to compare

upstream="$(git -C "$source_dir" rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || true)"
[ -n "$upstream" ] || exit 0 # no tracking branch, e.g. a local-only checkout

# --quiet so a routine fetch stays silent in the journal; failure is fine.
git -C "$source_dir" fetch --quiet --no-tags 2>/dev/null || exit 0

# --- is the weekly secrets check still running at all? -----------------------
#
# This lives here rather than in a fourth timer because it needs exactly what
# this one already is: something that fires daily and knows how to reach you.
#
# It is answering a question nothing else on the machine can. The weekly check
# marks its unit failed when it fails, which `systemctl --user --failed`
# surfaces — but a unit that has *stopped running* is, from there, identical to
# one that runs and passes: both are simply absent. A timer disabled by a
# botched apply, a unit whose ExecStart moved, a machine off for a month; all
# of them look like health.
#
# dotfiles-status --quiet is silent and exits 0 when the recorded state is
# fine, so the common case costs one exec and says nothing. Never fatal: this
# script's own job is the git comparison below, and a missing helper must not
# stop it.
if command -v dotfiles-status >/dev/null 2>&1; then
	if ! stale="$(dotfiles-status --quiet 2>&1)"; then
		if command -v notify-send >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
			notify-send --app-name=dotfiles --icon=dialog-warning --urgency=normal \
				"Dotfiles secrets need attention" \
				"$(printf '%s' "$stale" | head -2)"
		else
			printf 'dotfiles: %s\n' "$stale" >&2
		fi
	fi
fi

behind="$(git -C "$source_dir" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
[ "$behind" -gt 0 ] || exit 0

# Local commits mean this checkout is mid-work; say so rather than implying a
# clean fast-forward is waiting.
ahead="$(git -C "$source_dir" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
if [ "$ahead" -gt 0 ]; then
	body="$behind new upstream, $ahead local. Branch has diverged — reconcile before applying."
else
	body="$behind new commit(s) on $upstream. Run 'chezmoi update' to apply."
fi

# notify-send needs a session bus; a timer that fires outside a graphical login
# has none. Fall back to the journal so the check still leaves a trace.
if command -v notify-send >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	notify-send --app-name=dotfiles --icon=software-update-available \
		"Dotfiles out of date" "$body"
else
	echo "dotfiles: $body"
fi
