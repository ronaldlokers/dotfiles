#!/bin/sh
# Check that the Proton Pass path this machine depends on actually works.
#
# It started as two halves, because they are two code paths and only one was
# ever checked: every vault item must be readable by title, and every template
# that names a pass:// URI must render non-empty. `mise run secrets-check` was
# green while `chezmoi apply` was failing on a stale pass:// share id — item
# readability said nothing about whether a template could render.
#
# Each section since has been another "X is not the same claim as Y":
#   - the ssh keys load, which item readability does not imply
#   - an offline copy of the unreissuable secret exists and is current, which
#     is the only check here that matters when Proton itself is gone
#   - the bootstrap PAT has not expired, which no amount of reading the vault
#     today tells you about next year
#   - the devpod token is still *accepted by GitHub*, which is not the same as
#     the vault still handing it over
#
# A zero-template render half is treated as a fault, not a pass: this script
# runs unattended under a weekly timer, and `chezmoi execute-template
# --source /nonexistent` exits 0 while finding nothing, so a moved source tree
# or a template that stopped naming a pass:// URI would otherwise look
# identical to a healthy run. An EXIT trap backs that up — any abort this script did not reach on
# purpose (an unguarded command dying under `set -e`, a killed process) still
# alarms, rather than dying quietly with nobody told.
#
# Reports titles, template names and byte counts. Never contents: this runs
# unattended and its output lands in the journal.
#
# Run from dotfiles-secrets-check.timer, and safe to run by hand.
set -eu

usage() {
	cat <<'USAGE'
usage: dotfiles-secrets-check [--source REPO_ROOT]

Checks the Proton Pass path this machine depends on: every vault item readable,
every template naming a pass:// URI rendering, the ssh keys loadable, and an
offline copy of the unreissuable secret recorded and current.

Read-only — it fetches reports, it never writes a secret or applies anything.

  --source REPO_ROOT   check this repo instead of the configured chezmoi source
USAGE
}

# The repo root to check, when it is not this machine's configured chezmoi
# source — the mise task and the bats suite both pass one.
src_root=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--source)
		# `shift 2` with nothing after --source is a shell error (`shift count
		# out of range`, exit 1), not this script's own usage message. Check
		# before shifting so a bare `--source` gets the usage path (exit 2)
		# like every other malformed invocation.
		if [ $# -lt 2 ]; then
			usage >&2
			exit 2
		fi
		src_root="$2"
		shift 2
		;;
	*)
		echo "dotfiles-secrets-check: unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
done

vault="Dotfiles"

# Containers get nothing from Proton by design. .chezmoiignore keeps the applied
# copy out of one, but the source-tree copy is reachable from a devcontainer
# working on this repo, so probe at runtime as well. Same two markers as
# .chezmoitemplates/is-container, which answers the same question at apply time;
# `mise run lint` asserts the marker lists stay in step.
if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
	exit 0
fi

# Neither tool present means this machine was never set up for Proton. An
# ordinary state, not a fault — exit 0 and say nothing.
command -v pass-cli >/dev/null 2>&1 || exit 0
command -v chezmoi >/dev/null 2>&1 || exit 0

# notify-send needs a session bus; a timer firing outside a graphical login has
# none. Fall back to the journal so a failed run still leaves a trace.
#
# --urgency=critical is not decoration. This fires from a weekly timer, at
# whatever moment systemd picks — very possibly while the screen is locked or
# nobody is at the desk. A normal-urgency toast has a timeout, so the one
# notification this whole mechanism exists to deliver can expire unseen and the
# next one is seven days away. Critical toasts stay until dismissed.
alarm() {
	if command -v notify-send >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
		notify-send --app-name=dotfiles --icon=dialog-error --urgency=critical \
			"Proton Pass check failed" "$1"
	else
		echo "dotfiles: $1" >&2
	fi
}

# The warning counterpart: something is heading for a fault but nothing is
# broken yet. Normal urgency on purpose — it may repeat weekly for two months,
# and a run of undismissable toasts about a token that still works is how you
# learn to ignore the one that means something.
notice() {
	if command -v notify-send >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
		notify-send --app-name=dotfiles --icon=dialog-warning --urgency=normal \
			"Proton Pass check" "$1"
	else
		echo "dotfiles: $1" >&2
	fi
}

# Belt-and-braces for IMPORTANT 1: guarding one `render` call under `set -eu`
# does not stop the *next* unguarded one from killing the script before it
# reaches the summary and its own alarm() call, so nothing would notify. The
# unit does mark a non-zero exit as failed now, but `systemctl --failed` is a
# place you have to think to look; this is the part that reaches you. `reached_end`
# is set immediately before the two intended exits below this point (the dead
# -session fault and the final summary); the trap fires alarm() whenever the
# shell exits without it having been set. The three ordinary silent exits
# above (container, no pass-cli, no chezmoi) all happen before the trap is
# installed, so they are never touched by it.
reached_end=""
trap '[ -n "$reached_end" ] || alarm "dotfiles-secrets-check exited unexpectedly, before finishing its checks (see journal)."' EXIT

# Ask chezmoi to render, with or without an explicit source. A function rather
# than an unquoted variable so the flag cannot word-split. Stdin passes through
# untouched, so `render <file` renders a template read from disk.
render() {
	if [ -n "$src_root" ]; then
		chezmoi execute-template --source "$src_root" "$@"
	else
		chezmoi execute-template "$@"
	fi
}

# The bootstrap PAT's expiry. Nothing on this machine knew this date: README
# carried it in prose and that was the whole of the mechanism. The constant here
# and the README line are asserted to agree by `mise run lint`, so it cannot
# quietly become fiction the way a comment does.
#
# Computed before the session probe on purpose. An expired token is the single
# likeliest reason for the session below to be dead, and "no session" on its own
# names the symptom while this names the cause.
bootstrap_pat_expiry="2027-07-29"
bootstrap_pat_warn_days=60

# What to actually type, printed wherever the expiry is mentioned. It is three
# commands, not one, and the one-liner this used to print — `pass-cli pat renew`
# — does not run: renew requires --expiration and a token to name, and pass-cli
# refuses every `pat` subcommand outright while the session itself came from a
# PAT ("Cannot manage or act on personal access tokens while logged in with a
# personal access token"). Which is always the case here, because that cached
# PAT is exactly how this machine has a session at all. So the web login comes
# first, and it is the step that was missing.
#
# Printed at the moment of failure, not left to the README, because the failure
# arrives on a machine that has just stopped being able to read the vault and
# the README is in a repo you may be about to need the vault to check out.
pat_renew_help() {
	echo "      renew it: log in to Proton in a browser session first — a PAT-derived"
	echo "      session may not manage PATs — then name the token and give it a term:"
	echo "        pass-cli login"
	echo "        pass-cli pat list"
	echo "        pass-cli pat renew --personal-access-token-name <name> --expiration 1y"
	echo "      then update bootstrap_pat_expiry here and the date in README.md"
	echo "      (mise run lint asserts the two agree), and chezmoi apply."
}

pat_days_left=""
pat_expiry_epoch="$(date -u -d "$bootstrap_pat_expiry" +%s 2>/dev/null || true)"
if [ -n "$pat_expiry_epoch" ]; then
	# Floor, not truncate. Shell division rounds *toward zero*, so the plain
	# `(expiry - now) / 86400` this used to be produced 0 for the entire day
	# after expiry as well as the entire day before it — the token was expired
	# and the check said "expires in 0 days" instead of "expired", for a full
	# 24 hours, on the one day the distinction is the whole point. Negative
	# deltas are biased down by a day-minus-a-second before dividing so the
	# first hour past the deadline already reads -1.
	pat_delta=$((pat_expiry_epoch - $(date -u +%s)))
	if [ "$pat_delta" -lt 0 ]; then
		pat_days_left=$(((pat_delta - 86399) / 86400))
	else
		pat_days_left=$((pat_delta / 86400))
	fi
fi

# A dead session is the fault most worth reporting: every restore skips
# silently and the apply still exits 0. Report it as itself — without this the
# next loop would report all six items unreadable and bury the cause.
if ! pass-cli info >/dev/null 2>&1; then
	echo "FAIL  no Proton Pass session" >&2
	if [ -n "$pat_days_left" ] && [ "$pat_days_left" -lt 0 ]; then
		echo "FAIL  the bootstrap PAT expired on $bootstrap_pat_expiry — that is almost certainly why" >&2
		pat_renew_help >&2
		alarm "No Proton Pass session: the bootstrap PAT expired on $bootstrap_pat_expiry. See README, 'Renewing the bootstrap PAT'."
	else
		alarm "No Proton Pass session; secrets are not being refreshed. Run 'pass-cli login' to fix it."
	fi
	reached_end=1
	exit 1
fi

rc=0

# Separate from rc on purpose. A warning is "this will break, later" — the unit
# must stay green for it, or the systemd failure state and the `systemctl
# --failed` habit both stop meaning "something is broken now". Collected here so
# the summary can still say a warning happened rather than printing the same
# all-clear line as a run with nothing pending.
warned=0

# Ask chezmoi where the source dir is rather than assuming: .chezmoiroot puts it
# one level below the repo root, and --source takes the root.
#
# Guarded (IMPORTANT 1): under `set -eu` an unparsable chezmoi config makes
# `chezmoi execute-template` exit non-zero, which would otherwise kill the
# script here — before the summary and before alarm() ever runs. A failed or
# empty result is treated as a fault and the render loops below are skipped
# entirely rather than run against a garbage path.
src_dir="$(render '{{ .chezmoi.sourceDir }}' 2>/dev/null || true)"
if [ -z "$src_dir" ] || [ ! -d "$src_dir" ]; then
	printf 'FAIL  could not resolve the chezmoi source directory\n' >&2
	rc=1
	src_dir=""
fi

# --- derive the item list from the consumers that actually name items -------
# No hardcoded list: a title can only be wrong here if the consumer naming it
# is wrong. Two sources, each carrying its own field, because the field matters
# — a hand-kept list said `private_key` for the signing key while the template
# reads `public_key`, so the check passed on a field nothing consumed.
#
# Pairs are "field<TAB>title", one per line. Titles contain spaces, so the loop
# below splits on newlines only; a temp file would need its own cleanup in the
# EXIT trap for no gain.
#
# Accumulate with plain string concatenation and a literal trailing newline, NOT
# `items="$(printf '%s%s\n' "$items" "$new")"` — command substitution strips
# trailing newlines, so that form glues each entry onto the previous title with
# no separator and silently produces one mangled item.
items=""

# (a) restore "<title>" lines in the chezmoi scripts. Read as text, not
# rendered: the lines are literal in the template. The field is always `note` —
# restore() asks for exactly that.
#
# Leading whitespace is allowed, and that is not cosmetic. Anchoring on
# `^restore "` meant that wrapping a call in a conditional — indenting it —
# removed that secret from this check with nothing to show for it: no error, no
# count change anyone would notice, just one secret quietly no longer watched.
# That is the precise failure this derivation exists to prevent, arriving
# through the back door. A comment is still not a call: `#` is not whitespace,
# so `# restore "x"` stays out, and a test pins that.
if [ -n "$src_dir" ] && [ -d "$src_dir/.chezmoiscripts" ]; then
	restore_titles="$(grep -rhoE '^[[:space:]]*restore "[^"]+"' "$src_dir/.chezmoiscripts" 2>/dev/null |
		sed -e 's/^[[:space:]]*restore "//' -e 's/"$//' | sort -u || true)"
	if [ -n "$restore_titles" ]; then
		items="${items}$(printf '%s\n' "$restore_titles" | sed 's/^/note	/')
"
	else
		# The directory exists but named nothing: a renamed `restore` helper
		# (or a script moved out of it) makes this scan yield zero titles while
		# the URI source below can still yield some, leaving `items` non-empty
		# and the union check further down silent. This is that source's own
		# fault, caught here rather than relying on the union.
		printf 'FAIL  derived no restore titles from %s/.chezmoiscripts\n' "$src_dir" >&2
		rc=1
	fi
fi

# (b) pass://<vault>/<title>/<field> URIs, over the same file set half two
# scans, so "the templates" has one definition rather than two.
#
# The pattern demands all three segments. Grepping for the bare scheme also
# matches prose — this script's own comment about a stale `pass://` share id
# does — and the check would then try to fetch an item called "share id". The
# vault segment has no spaces, the title may, the field is a chezmoi item
# field name: letters, digits and underscores. `[a-z_]+` alone silently
# truncated a field with a digit or an uppercase letter (`api_key2` derived
# `api_key`) rather than failing loudly, so the class is widened to match
# whatever a field can actually be named.
#
# Held in one variable because both halves key off it: half one derives what to
# read from these URIs, half two derives what to render from the same shape.
# Half two used to grep for the literal string `protonPass` instead, which
# stopped being the marker the moment a template read the vault through
# pass-cli directly — a template can reference the vault without ever naming
# chezmoi's function. The URI is what actually says "this reads Proton Pass".
uri_re='pass://[^/"[:space:]]+/[^/"]+/[A-Za-z0-9_]+'

if [ -n "$src_dir" ]; then
	# shellcheck disable=SC2038  # source-tree file names have no spaces or
	# newlines anywhere in this repo, same assumption half two's identical
	# find-then-xargs below already makes.
	uris="$( { grep -rhoE "$uri_re" \
		"$src_dir/.chezmoitemplates" 2>/dev/null || true
		find "$src_dir" -type f -name '*.tmpl' -not -path '*/.git/*' 2>/dev/null |
			xargs -r grep -hoE "$uri_re" 2>/dev/null || true
	} | sort -u)"

	# A zero-URI scan must be caught here, not left to the union check below:
	# deleting the one file naming a pass:// URI (the exact bug this branch
	# exists to fix — `.chezmoitemplates/signing-pubkey`) leaves this source
	# empty while the restore titles above keep `items` non-empty, and the
	# union check would stay silent.
	if [ -d "$src_dir/.chezmoitemplates" ] && [ -z "$uris" ]; then
		printf 'FAIL  derived no pass:// URIs from %s\n' "$src_dir" >&2
		rc=1
	fi

	# Newline-only splitting here too. `for uri in $uris` splits on spaces, and
	# titles contain them: `pass://Dotfiles/git signing key/public_key` becomes
	# three words, yielding two bogus "vault" failures and one mangled item.
	# Confirmed against the real source tree before this plan was written.
	# `set -f`: a derived title can itself contain a glob character (`api *
	# keys`), and without this a matching filename in the current directory
	# silently replaces it before the loop body ever sees it.
	set -f
	old_ifs="$IFS"
	IFS='
'
	for uri in $uris; do
		IFS="$old_ifs"
		rest="${uri#pass://}"
		uri_vault="${rest%%/*}"
		rest="${rest#*/}"
		uri_title="${rest%/*}"
		uri_field="${rest##*/}"
		# Honouring a second vault would mean querying somewhere this repo does
		# not use. Fault rather than silently checking the wrong place.
		if [ "$uri_vault" != "$vault" ]; then
			printf 'FAIL  URI names vault %s, not %s: %s\n' \
				"$uri_vault" "$vault" "$uri" >&2
			rc=1
		else
			items="${items}${uri_field}	${uri_title}
"
		fi
		IFS='
'
	done
	IFS="$old_ifs"
	set +f
fi

# A zero-item derivation must be caught here: a moved restore script or a
# template that stopped naming a pass:// URI would otherwise yield nothing and
# still exit 0.
if [ -z "$items" ]; then
	printf 'FAIL  derived no vault items to check: the restore script or the templates moved\n' >&2
	rc=1
fi

items="$(printf '%s' "$items" | grep -v '^$' | sort -u || true)"

# --- half one: every derived item readable, on its own field ----------------
# Newline-only splitting: titles contain spaces. IFS is restored inside the
# loop so the body behaves normally, and again after it. `set -f`, same reason
# as the URI loop above: a derived title can contain a glob character.
#
# n_items is the counterpart to half two's n_tmpl: without it, a derivation
# that silently drops one of the two sources (a renamed `restore` helper, a
# template that stopped naming a pass:// URI) can leave the other source
# non-empty and this
# half prints the same "ok" shape either way — six items checked looks
# identical to one. The summary line below reports both counts so that
# distinction is visible without reading the item list itself.
n_items=0
set -f
old_ifs="$IFS"
IFS='
'
for pair in $items; do
	IFS="$old_ifs"
	n_items=$((n_items + 1))
	field="${pair%%	*}"
	title="${pair#*	}"
	n="$(pass-cli item view --vault-name "$vault" --item-title "$title" \
		--field "$field" 2>/dev/null | wc -c)"
	if [ "$n" -gt 0 ]; then
		printf 'ok    %-22s %s bytes\n' "$title" "$n"
	else
		printf 'FAIL  %-22s unreadable\n' "$title" >&2
		rc=1
	fi
	IFS='
'
done
IFS="$old_ifs"
set +f

# --- half two: every template naming a pass:// URI renders ------------------

# Counted, not just checked: a zero-match run (renamed marker string, moved
# templates directory, or a genuinely templateless repo) must not print the
# same summary as a run that found and rendered a dozen. The count is what
# tells "checked everything, all fine" apart from "checked nothing" — so a
# zero count is its own fault below, not a silently-empty half.
n_tmpl=0

if [ -n "$src_dir" ]; then
	tmpl_dir="$src_dir/.chezmoitemplates"

	if [ -d "$tmpl_dir" ]; then
		# Derived by grep, not hardcoded, so a new Proton-backed template is
		# covered without anyone remembering to register it. The name passed to
		# includeTemplate is the path relative to .chezmoitemplates, not the
		# bare basename: chezmoi addresses a template in a subdirectory as
		# "subdir/name", and a basename-only lookup for one would fail, have its
		# stderr swallowed by the `|| true` below, and get reported as "renders
		# empty" — a false failure rather than the lookup error it actually is.
		for path in $(grep -rlE "$uri_re" "$tmpl_dir" 2>/dev/null | sort); do
			name="${path#"$tmpl_dir"/}"
			n_tmpl=$((n_tmpl + 1))
			out="$(render "{{ includeTemplate \"$name\" . }}" 2>/dev/null || true)"
			if [ -n "$out" ]; then
				printf 'ok    %-22s renders %s bytes\n' \
					"$name" "$(printf '%s' "$out" | wc -c)"
			else
				printf 'FAIL  %-22s renders empty\n' "$name" >&2
				rc=1
			fi
		done
	else
		printf 'FAIL  templates directory missing: %s\n' "$tmpl_dir" >&2
		rc=1
	fi

	# .chezmoitemplates only holds partials reached through includeTemplate —
	# "every template naming a pass:// URI" is only true if a reference
	# anywhere else in the tree is covered too, so scan the rest of the source
	# tree for ordinary .tmpl files that name one directly and render each on
	# its own, the same way chezmoi apply would.
	# shellcheck disable=SC2038  # source-tree file names have no spaces or
	# newlines anywhere in this repo, same assumption the .chezmoitemplates
	# loop above already makes about template names.
	for path in $(find "$src_dir" -type f -name '*.tmpl' \
		-not -path "$tmpl_dir/*" -not -path '*/.git/*' 2>/dev/null |
		xargs -r grep -lE "$uri_re" 2>/dev/null | sort); do
		name="${path#"$src_dir"/}"
		n_tmpl=$((n_tmpl + 1))
		out="$(render <"$path" 2>/dev/null || true)"
		if [ -n "$out" ]; then
			printf 'ok    %-22s renders %s bytes\n' \
				"$name" "$(printf '%s' "$out" | wc -c)"
		else
			printf 'FAIL  %-22s renders empty\n' "$name" >&2
			rc=1
		fi
	done
fi

# --- the ssh half: ask the question proton-ssh-load asks --------------------
# proton-ssh-load runs `pass-cli ssh-agent load --vault-name Dotfiles`, which
# selects by item *type*, never by title. Checking titles tested something no
# code relies on, and reported a failure whenever a key was renamed in the
# vault while proton-ssh-load carried on working.
#
# `ssh-agent debug` answers the same question without touching the agent: this
# script must never mutate anything. Its output carries algorithms and
# fingerprints, never private key material, and only the counts are printed
# here so the weekly journal line stays stable.
#
# The exit code is captured, not discarded: a nonzero exit means pass-cli
# itself failed (a dead session mid-run, a broken pipe), which must not be
# read as "zero keys parsed" or silently ignored just because stdout still
# looked plausible.
ssh_debug_rc=0
ssh_out="$(pass-cli ssh-agent debug --vault-name "$vault" 2>/dev/null)" || ssh_debug_rc=$?

# Anchored to the trailing Summary: block, not to luck. The report also has a
# per-item header line, "Valid SSH Keys (N):", differing from the summary's
# "Valid SSH keys: N" only in capitalisation — a pattern that matches both
# would silently read whichever came first. Restricting the search to
# everything from "Summary:" onward means the header line is structurally out
# of reach rather than excluded by a capitalisation difference that could
# change under the next pass-cli release.
ssh_valid="$(printf '%s\n' "$ssh_out" |
	sed -n '/^Summary:/,${s/^[[:space:]]*Valid SSH keys:[[:space:]]*\([0-9][0-9]*\).*/\1/p;}' |
	head -n 1)"

# The Dotfiles vault holds the ssh keys alongside every other secret in this
# repo, so `Invalid Items` normally lists all of them too — every Note and
# Custom item comes back "Not an SSH key item (type: ...)", and a trashed
# item of any type comes back "Item is trashed". Both are pass-cli's own
# stable, self-describing wording for "this was never a candidate," verified
# against the live vault (7 invalid items, 0 of them ssh keys, on a run that
# must still exit 0). Only a reason outside those two shapes — an item that
# *was* a live ssh-key candidate and still failed, e.g. an unsupported
# algorithm — is treated as this check's business.
ssh_reason="$(printf '%s\n' "$ssh_out" |
	sed -n 's/^[[:space:]]*Reason:[[:space:]]*\(.*\)$/\1/p' |
	grep -Ev '^(Not an SSH key item|Item is trashed)' | head -n 1)"

# A trashed item is otherwise pure noise (above) — except when the trashed
# item *is* an ssh key. Trashing an item is one click and the likeliest way a
# key is actually lost, so that one case is this check's business even though
# the reason text alone ("Item is trashed") is indistinguishable from any
# other trashed item. The item's type is only available on the "• title
# (Type)" line above the Reason line, so both are read together: `type` is
# remembered from the most recent bullet line and consulted only when the
# very next Reason line says "trashed". Valid keys have no "(Type)" suffix
# and no Reason line, so they never reach the check.
#
# This awk block is parsed by whatever `awk` the host provides — gawk here,
# mawk on the CI runner (ubuntu-latest ships mawk as /usr/bin/awk, and it is
# byte-oriented rather than multibyte-aware). Stay byte-safe and POSIX in
# here: no regex bracket negation over a multibyte character such as
# `[^•]` — a byte-oriented awk splits that into a class of the character's
# individual UTF-8 bytes rather than "not this character". index(),
# substr() and length() are byte-oriented and behave identically across
# gawk, mawk and busybox awk, so the bullet is located with those instead.
ssh_trashed_key="$(printf '%s\n' "$ssh_out" | awk '
	/•/ {
		line = $0
		bullet_pos = index(line, "•")
		if (bullet_pos > 0) {
			line = substr(line, bullet_pos + length("•"))
			sub(/^[[:space:]]*/, "", line)
		}
		if (line ~ /\([^()]*\)[[:space:]]*$/) {
			title = line
			sub(/[[:space:]]*\([^()]*\)[[:space:]]*$/, "", title)
			type = line
			sub(/^.*\(/, "", type)
			sub(/\)[[:space:]]*$/, "", type)
		} else {
			title = line
			type = ""
		}
		next
	}
	/Reason:/ {
		if (type == "SSH Key" && $0 ~ /trashed/) {
			print title
		}
		type = ""
	}
')"

# Fails closed. A nonzero exit, an unparsable summary and an empty parse are
# all treated the same way: loud, because a silent zero here means git push
# stops working on the next machine that boots without keys.
if [ "$ssh_debug_rc" -ne 0 ]; then
	printf 'FAIL  %-22s ssh-agent debug exited %s\n' "ssh keys" "$ssh_debug_rc" >&2
	rc=1
elif [ -n "$ssh_reason" ]; then
	printf 'FAIL  %-22s %s\n' "ssh keys" "invalid item: $ssh_reason" >&2
	rc=1
elif [ -n "$ssh_trashed_key" ]; then
	printf 'FAIL  %-22s trashed ssh key: %s\n' "ssh keys" "$ssh_trashed_key" >&2
	rc=1
elif [ -z "$ssh_valid" ] || [ "$ssh_valid" -eq 0 ]; then
	printf 'FAIL  %-22s no valid ssh keys (or unparsable debug output)\n' "ssh keys" >&2
	rc=1
else
	printf 'ok    %-22s %s valid ssh keys\n' "ssh keys" "$ssh_valid"
fi

# Independent of $rc: the ssh half above runs first and may already have set
# rc=1, and this diagnostic must not go silent just because something else
# also failed — a moved source tree or a template that stopped naming a
# pass:// URI is its own
# fault, worth its own line, whether or not the ssh half also had one.
if [ "$n_tmpl" -eq 0 ]; then
	printf 'FAIL  0 proton templates found: this usually means the source tree moved or a template stopped naming a pass:// URI\n' >&2
	rc=1
fi

# --- the offline half: is there a way back if Proton is not there? ----------
#
# Every check above asks whether Proton still works. This one asks the opposite
# question, and it is the only one whose answer matters on the day the others
# stop mattering: one lockout — forgotten password, lost 2FA device, account
# problem — takes the SSH keys, the file secrets and the recovery path at the
# same moment, because they are all the same account.
#
# `dotfiles-secrets-export` writes the offline copy and records what it wrote;
# this reads that record. The backup medium does NOT need to be plugged in. The
# recorded fingerprint is the age *public* key, derivable from the private one
# and safe to keep in cleartext, so comparing it against the vault answers "has
# the key rotated since the copy was made" without the copy being present and
# without either half printing a secret.
#
# Staleness is a fingerprint mismatch, not an age in days. An untouched key
# means a two-year-old copy is still a perfectly good copy, and a check that
# nagged about that would only teach you to ignore it.
backup_manifest="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/secrets-backup"
backup_item="sops age keys"

if ! command -v age-keygen >/dev/null 2>&1; then
	printf 'FAIL  %-22s age-keygen not installed; cannot verify the copy\n' "offline backup" >&2
	rc=1
elif [ ! -f "$backup_manifest" ]; then
	printf 'FAIL  %-22s no offline copy has ever been recorded\n' "offline backup" >&2
	printf '      Proton is otherwise the only copy. Run: dotfiles-secrets-export <destination>\n' >&2
	rc=1
else
	recorded_key="$(sed -n 's/^age_public_key=//p' "$backup_manifest" | head -1)"
	recorded_when="$(sed -n 's/^date=//p' "$backup_manifest" | head -1)"
	# Through a pipe, never a file: the private key must not touch this disk on
	# the way past, and this script must never write anything anywhere.
	current_key="$(pass-cli item view --vault-name "$vault" \
		--item-title "$backup_item" --field note 2>/dev/null |
		age-keygen -y - 2>/dev/null || true)"

	if [ -z "$current_key" ]; then
		printf 'FAIL  %-22s cannot read the vault age key to compare against\n' "offline backup" >&2
		rc=1
	elif [ -z "$recorded_key" ]; then
		printf 'FAIL  %-22s the record names no key; re-run the export\n' "offline backup" >&2
		rc=1
	elif [ "$recorded_key" != "$current_key" ]; then
		printf 'FAIL  %-22s vault age key changed since %s; the copy is stale\n' \
			"offline backup" "$recorded_when" >&2
		printf '      Re-run: dotfiles-secrets-export <destination>\n' >&2
		rc=1
	else
		# "current" is a claim about the *record*, and it is worth being honest
		# about how narrow that is: this compares fingerprints, so it proves the
		# vault's key has not rotated since the copy was made. It never opens
		# the backup. Whether the file still decrypts, whether the passphrase is
		# the one you think it is, whether the medium is readable — none of that
		# is knowable from here, and all of it is what matters on the day. That
		# is what dotfiles-secrets-restore is for, and why the line says so.
		printf 'ok    %-22s current as of %s (verify it reads back: dotfiles-secrets-restore <file>)\n' \
			"offline backup" "$recorded_when"
	fi
fi

# --- the bootstrap PAT: readable today is not the same as valid next year ----
if [ -z "$pat_days_left" ]; then
	printf 'FAIL  %-22s cannot parse the recorded expiry (%s)\n' \
		"bootstrap PAT" "$bootstrap_pat_expiry" >&2
	rc=1
elif [ "$pat_days_left" -lt 0 ]; then
	printf 'FAIL  %-22s expired on %s\n' \
		"bootstrap PAT" "$bootstrap_pat_expiry" >&2
	pat_renew_help >&2
	rc=1
elif [ "$pat_days_left" -le "$bootstrap_pat_warn_days" ]; then
	# A warning, not a fault, and this distinction is the whole reason `warned`
	# exists. The window is 60 days wide and the timer is weekly, so treating it
	# as a failure marks the unit failed roughly eight times in a row over a
	# token that is still working perfectly — which trains you to stop reading
	# `systemctl --failed`, the exact habit the rest of this script depends on.
	printf 'warn  %-22s expires in %s days (%s)\n' \
		"bootstrap PAT" "$pat_days_left" "$bootstrap_pat_expiry" >&2
	pat_renew_help >&2
	warned=1
	notice "The Proton Pass bootstrap PAT expires in $pat_days_left days ($bootstrap_pat_expiry). See README, 'Renewing the bootstrap PAT'."
else
	printf 'ok    %-22s %s days left (%s)\n' \
		"bootstrap PAT" "$pat_days_left" "$bootstrap_pat_expiry"
fi

# --- the devpod token: readable is not the same as live ---------------------
#
# Every check above proves the vault still hands the token over. None of them
# proves GitHub still accepts it, and a lapsed one fails in the least helpful
# possible way: `devpod up` dies partway through a container build with `rate
# limit exceeded`, which looks exactly like the anonymous-quota bug this token
# was introduced to fix, with every local check green.
devpod_item="devpod dotfiles-env"
if ! command -v curl >/dev/null 2>&1; then
	printf 'FAIL  %-22s curl not installed; cannot check the token is live\n' \
		"devpod PAT" >&2
	rc=1
else
	devpod_token="$(pass-cli item view --vault-name "$vault" \
		--item-title "$devpod_item" --field note 2>/dev/null |
		sed -n 's/^[[:space:]]*MISE_GITHUB_TOKEN=//p' | head -1)"
	if [ -z "$devpod_token" ]; then
		printf 'FAIL  %-22s no MISE_GITHUB_TOKEN in "%s"\n' \
			"devpod PAT" "$devpod_item" >&2
		rc=1
	else
		# The header goes in through a config on stdin, never as -H: an
		# argument is visible in `ps` to every user on the machine. Same rule
		# that keeps proton-ssh-load off --personal-access-token, and
		# tests/secrets-check.bats pins it the same way.
		#
		# /rate_limit answers 200 to anonymous requests too, so the status code
		# alone proves nothing — an unsent or ignored header would read as
		# success. The limit is what discriminates: 60 anonymous, 5000
		# authenticated, whatever the token's scopes. It also costs no quota.
		#
		# -q comes first and is not optional. Keeping the header out of argv
		# is only half the job: before curl reads any argument it reads
		# ~/.curlrc, and that file can turn this into a call that writes the
		# token to disk — a `trace-ascii <path>` line there dumps every
		# request header, Authorization included, into a file with default
		# permissions. Nothing in this repo writes a ~/.curlrc, and that is
		# exactly the problem: it is a file outside chezmoi's control that
		# silently rewrites what this command does. -q says "read no config
		# file"; --config - then supplies the only one this call wants.
		probe="$(printf 'header = "Authorization: Bearer %s"\nsilent\n' "$devpod_token" |
			curl -q --config - -o /dev/null -m 15 \
				-w '%{http_code} %header{x-ratelimit-limit}' \
				https://api.github.com/rate_limit 2>/dev/null || true)"
		unset devpod_token
		http_code="${probe%% *}"
		rate_limit="${probe#* }"
		case "$http_code" in
		200)
			if [ -z "$rate_limit" ]; then
				printf 'FAIL  %-22s GitHub sent no rate-limit header; cannot tell if it was accepted\n' \
					"devpod PAT" >&2
				rc=1
			elif [ "$rate_limit" -gt 60 ]; then
				printf 'ok    %-22s live (rate limit %s)\n' "devpod PAT" "$rate_limit"
			else
				printf 'FAIL  %-22s GitHub answered anonymously (rate limit %s); the token was not accepted\n' \
					"devpod PAT" "$rate_limit" >&2
				rc=1
			fi
			;;
		401 | 403)
			printf 'FAIL  %-22s rejected by GitHub (HTTP %s); mint a new one and update the vault item\n' \
				"devpod PAT" "$http_code" >&2
			rc=1
			;;
		000 | "")
			# Not a fault: this one call needs GitHub specifically, and every
			# other check above needed only Proton. Saying "the token is bad"
			# because github.com was unreachable would be a lie that trains you
			# to ignore the line.
			printf 'skip  %-22s could not reach GitHub; token not checked\n' "devpod PAT" >&2
			;;
		*)
			printf 'FAIL  %-22s unexpected HTTP %s from GitHub\n' \
				"devpod PAT" "$http_code" >&2
			rc=1
			;;
		esac
	fi
fi

if [ "$rc" -eq 0 ] && [ "$warned" -eq 0 ]; then
	echo "every secret readable; $n_items vault item(s) checked, $n_tmpl proton template(s) render"
elif [ "$rc" -eq 0 ]; then
	# Green, but not the same green. Exits 0 so the unit stays passed; says
	# "with warnings" so a journal line from this run is not indistinguishable
	# from a run with nothing pending at all.
	echo "every secret readable, with warnings above; $n_items vault item(s) checked, $n_tmpl proton template(s) render"
else
	alarm "The Proton Pass check failed. Run 'mise run secrets-check' for detail."
fi

reached_end=1
exit "$rc"
