#!/usr/bin/env bash
set -euo pipefail

# patsub_replacement (bash 5.2+) makes a bare & in a ${var//x/y} replacement
# expand to the match. Off, so the substitution below stays literal. Older
# bashes lack the option and don't need it.
shopt -u patsub_replacement 2>/dev/null || true

# Scaffold a project devcontainer from the managed starter in
# ~/.local/share/devcontainer-template.

# Hard-coded, not ${XDG_DATA_HOME:-$HOME/.local/share}: chezmoi maps
# dot_local/share/... to $HOME/.local/share/... unconditionally, ignoring
# XDG_DATA_HOME.
template="$HOME/.local/share/devcontainer-template"
target=".devcontainer"
force=false

# stdout: requested help is not an error. The unknown-argument path redirects
# to stderr itself.
usage() {
	cat <<'EOF'
usage: devcontainer-init [--force]

Writes .devcontainer/{devcontainer.json,Dockerfile,post-create.sh} into the
current directory, naming the container after the directory.

  --force   overwrite an existing .devcontainer/
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
	--force) force=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

if [ ! -d "$template" ]; then
	echo "no template at $template — run 'chezmoi apply' first" >&2
	exit 1
fi

# All template files must exist and be non-empty before anything is written,
# so a half-applied template does not produce a half-written project.
if [ ! -s "$template/devcontainer.json" ] || [ ! -s "$template/post-create.sh" ] ||
	[ ! -s "$template/Dockerfile" ]; then
	echo "incomplete template at $template — expected devcontainer.json, post-create.sh and Dockerfile" >&2
	exit 1
fi

# The directory name, verbatim. Casing is left alone: a project called WalkFit
# should show up as WalkFit in `devpod list`, not walkfit.
name="$(basename "$PWD")"

# A name with a quote, backslash or control character cannot go raw into the
# JSON "name" field. This
# script deliberately doesn't escape it — refusing is honest, the case is
# rare, and renaming the directory is the real fix.
if [[ "$name" == *'"'* || "$name" == *'\'* || "$name" =~ [[:cntrl:]] ]]; then
	echo "directory name '$name' can't go into JSON as-is (contains \", \\, or a control character) — rename the directory and try again" >&2
	exit 1
fi

# A symlinked .devcontainer is refused outright, --force or not: following it
# would write straight through into whatever directory it points at,
# silently, outside the project.
if [ -L "$target" ]; then
	echo "$target is a symlink; refusing to write through it" >&2
	exit 1
fi

if [ -e "$target" ] && [ "$force" = false ]; then
	echo "$target already exists; pass --force to overwrite" >&2
	exit 1
fi

# Build the new .devcontainer in a scratch directory first, on the same
# filesystem as the project — not $TMPDIR, which is typically a different
# filesystem and would make the move into place below degrade to
# copy-plus-unlink. Moving the whole scratch directory into place as one
# rename means a failure partway through (a full disk, an interrupted run)
# never leaves a half-written target for the next invocation to mistake for
# a real one.
staging="$(mktemp -d "./.devcontainer-init.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
# mktemp -d always creates at 0700, ignoring umask — fine for a scratch dir,
# but this one gets renamed into place as $target below, so it needs the
# permissions a plain `mkdir -p "$target"` would have given it instead.
chmod "$(printf '%04o' "$(( 0777 & ~$(umask) ))")" "$staging"

# Bash pattern substitution, not sed: the replacement is used literally, so
# a name containing a sed-special character like & or \ can't corrupt the
# output the way `sed "s/.../$name/"` would.
template_json="$(cat "$template/devcontainer.json")"
printf '%s\n' "${template_json//__PROJECT_NAME__/$name}" >"$staging/devcontainer.json"
# post-create.sh is copied as-is; nothing is rewritten there.
cp "$template/post-create.sh" "$staging/post-create.sh"
# The Dockerfile likewise: the image is built per project from this copy, so
# a project that needs an extra package edits its own rather than the
# template.
cp "$template/Dockerfile" "$staging/Dockerfile"

# Only reachable with an existing $target when --force was passed — the
# non-force case already exited above, and the symlink case already exited
# even earlier, so this never follows a link. A real directory is cleared
# recursively; a plain file is just removed.
if [ -e "$target" ]; then
	if [ -d "$target" ]; then
		rm -rf "$target"
	else
		rm -f "$target"
	fi
fi

# One rename for the whole directory, not one per file: a single same-
# filesystem rename is atomic, so there's no window where $target holds one
# file but not the other.
mv "$staging" "$target"

echo "wrote $target/devcontainer.json"
echo "wrote $target/post-create.sh"
echo "wrote $target/Dockerfile"
