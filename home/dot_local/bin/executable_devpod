#!/bin/sh
# DevPod containers have no gh session, so mise hits GitHub's anonymous 60/hour
# rate limit during a cold bootstrap and the all-or-nothing tool install dies on
# HTTP 403. The token that fixes it can only be passed as a `devpod up` flag:
# DevPod exposes no context option for it (v0.6.15 has DOTFILES_SCRIPT and
# DOTFILES_URL and nothing else), so something has to add the flag on every
# invocation.
#
# This was a shell function in .zshrc and .bashrc until it turned out that a
# function can only ever cover interactive shells: `bash -c`, `zsh -c`, a
# script, a cron job and an agent tool call all skip the rc files, so they got
# no token and silently fell back to the anonymous quota — failing only on the
# days that quota was already spent. A real executable on PATH covers every
# caller, which is why the pinned binary now lands in ~/.local/libexec and this
# sits in front of it.
#
# MISE_QUIET drops roughly forty lines of mise install progress relayed through
# DevPod's logger while keeping the errors — a failing install still prints
# `mise ERROR …` and exits non-zero. Deliberately not devpod's own `--silent`,
# which suppresses everything short of a panic, including the `Execution of
# ./setup was unsuccessful` line that is how a broken bootstrap announces
# itself.
#
# CXXFLAGS=-w for the same reason, one layer down. gemini-cli depends on
# node-pty, which ships no prebuilt binary for the pinned node, so every
# container compiles it with node-gyp and gcc reports warnings in nan and in
# node's own headers — upstream code, nothing here can act on it. `-w` drops
# warnings only: a real compile error still prints and still fails the build.
set -eu

real="$HOME/.local/libexec/devpod"
env_file="$HOME/.config/devpod/dotfiles-env"

# Missing binary means the external hasn't landed (or this is a platform it
# skips). Say so rather than dying with a bare "not found" on a name the user
# can see on PATH.
if [ ! -x "$real" ]; then
	echo "devpod: $real is missing — run 'chezmoi apply' to fetch it" >&2
	exit 127
fi

# Find the subcommand by walking the arguments rather than reading $1: global
# flags may come first, and the four listed below take a value that must not be
# mistaken for the subcommand.
sub=""
skip=0
for arg in "$@"; do
	if [ "$skip" = 1 ]; then
		skip=0
		continue
	fi
	case "$arg" in
	--context | --devpod-home | --log-output | --provider)
		skip=1
		;;
	-*) ;;
	*)
		sub="$arg"
		break
		;;
	esac
done

ws_env=""

# Remove the generated workspace env file whatever happens after it is written.
cleanup() {
	[ -n "$ws_env" ] && rm -f "$ws_env"
}

if [ "$sub" = "up" ]; then
	set -- "$@" --dotfiles-script-env MISE_QUIET=1 \
		--dotfiles-script-env CXXFLAGS=-w
	# The flag carries the *path*, never the value: the token must not reach
	# this process's arguments, where any `ps` could read it.
	if [ -r "$env_file" ]; then
		set -- "$@" --dotfiles-script-env-file "$env_file"
	fi

	# gh inside the container, for `gh` itself and for HTTPS pushes through the
	# `gh auth git-credential` helper in dot_config/git/config.tmpl — both read
	# GH_TOKEN straight from the environment, so this one variable is the whole
	# integration.
	#
	# Deliberately GH_TOKEN and not GITHUB_TOKEN or MISE_GITHUB_TOKEN: mise
	# reads the latter two, and the tool-install path must keep using the
	# no-scope PAT in $env_file. Only gh should ever hold the powerful token.
	#
	# Generated per invocation rather than kept on disk, because gh rotates its
	# OAuth token and a stale copy would authenticate as nothing. It lives in
	# $XDG_RUNTIME_DIR (tmpfs, 0700, cleared at logout), is written 0600, and is
	# removed as soon as devpod returns.
	#
	# KNOWN EXPOSURE, accepted deliberately: DevPod materialises workspace env
	# as /etc/envfile.json *inside* the container, mode 0644. Every process and
	# every user in that container can read this token for the container's
	# lifetime — a dependency's postinstall script, a test, an agent. It is a
	# full-scope user token: whatever it can push to, they can push to. The
	# no-scope PAT above is the model to copy for anything that does not
	# specifically need gh.
	if command -v gh >/dev/null 2>&1; then
		gh_token="$(gh auth token 2>/dev/null || true)"
		if [ -n "$gh_token" ]; then
			ws_env="${XDG_RUNTIME_DIR:-$HOME/.cache}/devpod-workspace-env.$$"
			(
				umask 077
				printf 'GH_TOKEN=%s\n' "$gh_token" >"$ws_env"
			)
			unset gh_token
			set -- "$@" --workspace-env-file "$ws_env"
		fi
	fi
fi

# `exec` for everything else, so devpod owns the terminal and the signals. The
# `up` path with a generated env file has to stay in the foreground instead, so
# the file can be removed once devpod is done with it.
if [ -n "$ws_env" ]; then
	trap cleanup EXIT HUP INT TERM
	"$real" "$@"
	rc=$?
	cleanup
	exit "$rc"
fi

exec "$real" "$@"
