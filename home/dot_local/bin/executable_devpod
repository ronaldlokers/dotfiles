#!/bin/sh
# Wrapper for the pinned devpod binary in ~/.local/libexec. Adds the
# dotfiles-script env flags to every `devpod up`: a no-scope GitHub token for
# mise's rate limit, plus MISE_QUIET and CXXFLAGS=-w to keep bootstrap output
# readable. Run ~/.local/libexec/devpod directly to bypass this.
#
# The one script in ~/.local/bin that deliberately does NOT handle `--help`
# itself. Every other one prints its own usage and exits 0; this is a
# pass-through wrapper, and someone typing `devpod --help` wants devpod's help,
# not a note about the wrapper. Intercepting it would hide the thing they asked
# for. Everything here is forwarded, including that.
set -eu

real="$HOME/.local/libexec/devpod"
env_file="$HOME/.config/devpod/dotfiles-env"

# Missing binary means the external has not landed, or this platform skips it.
if [ ! -x "$real" ]; then
	echo "devpod: $real is missing — run 'chezmoi apply' to fetch it" >&2
	exit 127
fi

# Walk the arguments rather than reading $1: flags may precede the subcommand,
# and a lot of them take a value in the next argument. The first non-flag
# argument is the subcommand, the second is the workspace source, which the
# per-project token lookup keys on.
#
# The list used to hold four global flags and nothing else, so `devpod up --ide
# vscode ../other-project` parsed `vscode` as the source — and `vscode` is not a
# directory, so the lookup fell back to $PWD and handed *this* project's
# fine-grained token to a container built for a different repo. Every existing
# test used the bare `devpod up .` form, so the entire walk was uncovered.
#
# `--flag=value` needs no entry: the value is attached, so the argument after it
# is genuinely the next argument. Only the space-separated form skips.
sub=""
src=""
src_seen=0
skip=0
for arg in "$@"; do
	if [ "$skip" = 1 ]; then
		skip=0
		continue
	fi
	case "$arg" in
	# globals
	--context | --devpod-home | --log-output | --provider | \
		--devcontainer-image | --devcontainer-path | --dotfiles | \
		--dotfiles-script | --dotfiles-script-env | --dotfiles-script-env-file | \
		--fallback-image | --git-clone-strategy | --git-ssh-signing-key | \
		--id | --ide | --ide-option | --init-env | --machine | \
		--prebuild-repository | --provider-option | --source | --ssh-config | \
		--workspace-env | --workspace-env-file)
		skip=1
		;;
	-*) ;;
	*)
		if [ -z "$sub" ]; then
			sub="$arg"
		else
			src="$arg"
			src_seen=1
			break
		fi
		;;
	esac
done

ws_env=""

cleanup() {
	[ -n "$ws_env" ] && rm -f "$ws_env"
}

# Opt-in per-project GitHub token, for projects whose workflow needs the GitHub
# API (`gh pr create`). Git itself needs none — containers use the forwarded
# agent. ~/.config/devpod/project-tokens is `owner/repo=token`, 0600, restored
# from the Proton Pass vault and empty on a machine with no entries yet; each
# entry should be fine-grained and limited to that one repo.
project_token() {
	tokens="$HOME/.config/devpod/project-tokens"
	[ -r "$tokens" ] || return 1

	# Key on the push remote, not the directory name: a fork is what you can
	# mint a token for.
	#
	# Two cases, and the difference matters more than it looks. No source
	# argument at all is the common `devpod up` / `devpod up .` shape, and $PWD
	# is the right answer. A source argument that is *not* a directory means
	# either a flag value this walk failed to recognise or an existing
	# workspace addressed by name — and in both cases $PWD is a different
	# project from the one being built. Falling back there is how one repo's
	# token ends up inside another repo's container, so it fails closed: no
	# token, and the container simply does without.
	if [ "$src_seen" = 1 ]; then
		proj="$1"
		if [ ! -d "$proj" ]; then
			echo "devpod: '$proj' is not a local directory; not injecting a project token." >&2
			return 1
		fi
	else
		proj="$PWD"
	fi
	url="$(git -C "$proj" remote get-url --push origin 2>/dev/null)" || return 1
	[ -n "$url" ] || return 1

	# Both remote URL forms reduce to owner/repo.
	key="$(printf '%s' "$url" |
		sed -e 's|^git@github\.com:||' \
			-e 's|^ssh://git@github\.com/||' \
			-e 's|^https://github\.com/||' \
			-e 's|\.git$||')"
	[ -n "$key" ] || return 1

	# Tolerate the spacing a web-edited vault note invites. Splitting on the
	# first `=` by hand keeps a value containing `=` intact, and the fields are
	# never assigned to: assigning to $1 rebuilds $0 joined by OFS, which would
	# turn the separators into spaces and corrupt the value.
	awk -v k="$key" '
	{
		line = $0
		sub(/^[[:space:]]+/, "", line)
		sub(/[[:space:]]+$/, "", line)
		eq = index(line, "=")
		if (eq == 0) next
		lk = substr(line, 1, eq - 1)
		val = substr(line, eq + 1)
		sub(/[[:space:]]+$/, "", lk)
		sub(/^[[:space:]]+/, "", val)
		if (lk == k && val != "") { print val; exit }
	}' "$tokens"
}

if [ "$sub" = "up" ]; then
	set -- "$@" --dotfiles-script-env MISE_QUIET=1 \
		--dotfiles-script-env CXXFLAGS=-w
	# The flag carries the path, never the value — `ps` would show the value.
	if [ -r "$env_file" ]; then
		set -- "$@" --dotfiles-script-env-file "$env_file"
	fi

	# stderr is not redirected here: the only thing this writes to it is the
	# "not injecting a project token" refusal, and a refusal nobody sees is
	# indistinguishable from a project that simply has no token entry. Every
	# noisy command inside already silences itself.
	tok="$(project_token "$src" || true)"
	if [ -n "$tok" ]; then
		# GH_TOKEN, not GITHUB_TOKEN/MISE_GITHUB_TOKEN: mise reads those and
		# must keep using the no-scope PAT above.
		ws_env="${XDG_RUNTIME_DIR:-$HOME/.cache}/devpod-workspace-env.$$"
		(
			umask 077
			printf 'GH_TOKEN=%s\n' "$tok" >"$ws_env"
		)
		unset tok
		set -- "$@" --workspace-env-file "$ws_env"
	fi
fi

# `exec` elsewhere so devpod owns the terminal and signals; the env-file path
# stays in the foreground so the file can be removed afterwards.
if [ -n "$ws_env" ]; then
	trap cleanup EXIT HUP INT TERM
	"$real" "$@"
	rc=$?
	cleanup
	exit "$rc"
fi

exec "$real" "$@"
