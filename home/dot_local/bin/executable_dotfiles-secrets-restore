#!/bin/sh
# Read back the passphrase-encrypted offline copy that dotfiles-secrets-export
# wrote — either to check it still works, or to put the key back.
#
# The export has been write-only since it was added. That is the classic shape
# of a backup that turns out not to be one: it is made, it is recorded, the
# weekly check confirms a *record* exists and matches a fingerprint, and nobody
# ever decrypts the file. A fingerprint match proves the vault's key has not
# rotated. It proves nothing about the copy — not that the passphrase is what
# you think, not that the medium is readable, not that the bytes survived.
#
# So the default mode here is --verify, and it is the one worth running from
# time to time. Restoring is the emergency, and the emergency is not when you
# want to discover the passphrase was mistyped.
#
# What it deliberately does NOT do: print the key. `age -d <file>` puts the
# private key straight into your scrollback, your terminal's buffer and quite
# possibly your multiplexer's save file — which the README suggested as the way
# to test the backup. This exists so that suggestion can stop being the answer.
set -eu

usage() {
	cat <<'USAGE'
usage: dotfiles-secrets-restore [--verify | --write] [--force] <backup-file>

Reads the passphrase-encrypted copy written by dotfiles-secrets-export.

  --verify   decrypt it, check it is a usable age identity, compare it against
             the recorded fingerprint, and write nothing. The default.
  --write    additionally write it back to the sops key file
  --force    with --write, replace an existing key file

You are asked for the passphrase. The key itself is never printed — only its
public half, which is safe to look at and is what identifies it.
USAGE
}

mode="verify"
force=0
backup=""

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--verify) mode="verify" ;;
	--write) mode="write" ;;
	--force) force=1 ;;
	-*)
		echo "dotfiles-secrets-restore: unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	*)
		if [ -n "$backup" ]; then
			echo "dotfiles-secrets-restore: more than one backup file given" >&2
			usage >&2
			exit 2
		fi
		backup="$1"
		;;
	esac
	shift
done

if [ -z "$backup" ]; then
	usage >&2
	exit 2
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
manifest="$state_dir/secrets-backup"
key_target="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"

for tool in age age-keygen; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "dotfiles-secrets-restore: $tool is not installed" >&2
		exit 1
	fi
done

if [ ! -f "$backup" ]; then
	echo "dotfiles-secrets-restore: no such file: $backup" >&2
	exit 1
fi

if [ ! -s "$backup" ]; then
	echo "dotfiles-secrets-restore: $backup is empty" >&2
	exit 1
fi

# `age -d` on a passphrase file prompts, and needs a terminal to do it. Same
# reasoning as the export's own guard: failing here with a sentence beats
# failing inside age with a confusing one, or blocking forever with none.
if [ ! -t 0 ]; then
	echo "dotfiles-secrets-restore: needs a terminal to ask for the passphrase" >&2
	echo "Run it from an interactive shell." >&2
	exit 1
fi

# Everything below holds the decrypted key in a shell variable and never writes
# it anywhere except, in --write mode, the one file it is meant to land in.
# Command substitution keeps it out of the process table and off disk on the way
# past — the same rule the export follows in the other direction.
echo "Decrypting $backup. You will be asked for the passphrase you chose."
plain="$(age -d "$backup" 2>/dev/null || true)"
if [ -z "$plain" ]; then
	echo "dotfiles-secrets-restore: could not decrypt $backup" >&2
	echo "Wrong passphrase, or the file is damaged. Nothing was written." >&2
	exit 1
fi

# A file that decrypts is not yet a file that is worth anything. This is the
# assertion the fingerprint check in dotfiles-secrets-check structurally cannot
# make, because it never opens the backup.
pubkey="$(printf '%s\n' "$plain" | age-keygen -y - 2>/dev/null || true)"
if [ -z "$pubkey" ]; then
	echo "dotfiles-secrets-restore: it decrypted, but the contents are not a usable age identity" >&2
	exit 1
fi

echo "ok    decrypts, and is a usable age identity"
printf 'ok    public key: %s\n' "$pubkey"

# Compare against what the export recorded, when there is a record to compare
# with. A mismatch is not necessarily an error — an older backup of a key that
# has since rotated is exactly what a mismatch looks like, and that copy may
# still be the one you need — so it is reported rather than fatal.
if [ -f "$manifest" ]; then
	recorded="$(sed -n 's/^age_public_key=//p' "$manifest" | head -1)"
	recorded_when="$(sed -n 's/^date=//p' "$manifest" | head -1)"
	if [ -z "$recorded" ]; then
		echo "warn  the local record names no key; cannot compare" >&2
	elif [ "$recorded" = "$pubkey" ]; then
		printf 'ok    matches the copy recorded on %s\n' "$recorded_when"
	else
		echo "warn  this is NOT the key the local record names." >&2
		echo "      Recorded: $recorded" >&2
		echo "      This file: $pubkey" >&2
		echo "      An older backup of a key that has since rotated looks exactly" >&2
		echo "      like this, and may still be the copy you want." >&2
	fi
else
	echo "warn  no local record to compare against (no export has run on this machine)" >&2
fi

if [ "$mode" = "verify" ]; then
	echo
	echo "Verified. Nothing was written — pass --write to restore it."
	exit 0
fi

# --- --write ----------------------------------------------------------------

# Not a regular file: refuse outright, and --force does not override this.
#
# `mv "$tmp" "$dir"` does not fail — it moves the file *into* the directory and
# reports success. Reproduced: with a directory at the target, --force skipped
# the existence check below, the key landed at `keys.txt/keys.txt.tmp.$$`, the
# `chmod 600` then stripped the directory's execute bit so nothing could reach
# it, and the script printed `wrote …/keys.txt` and exited 0. On the one path
# where the backup is the only copy left.
#
# The identical hazard is already guarded, with an explanatory comment, in
# run_after_13-ensure-ssh-include.sh — the lesson was in the tree and had not
# been applied here. -L is checked separately because -e is false for a
# dangling symlink, so the existence guard alone would not catch one.
if [ -L "$key_target" ]; then
	echo "dotfiles-secrets-restore: $key_target is a symlink" >&2
	echo "Refusing: writing through it would put the key somewhere this script" >&2
	echo "did not choose. Resolve it by hand and re-run." >&2
	exit 1
fi

if [ -e "$key_target" ] && [ ! -f "$key_target" ]; then
	echo "dotfiles-secrets-restore: $key_target exists and is not a regular file" >&2
	echo "Refusing: a move onto it would succeed and put the key inside it." >&2
	exit 1
fi

if [ -e "$key_target" ] && [ "$force" != 1 ]; then
	echo "dotfiles-secrets-restore: $key_target already exists" >&2
	echo "Refusing to replace it. If the existing file is the one you want to" >&2
	echo "lose, re-run with --force." >&2
	exit 1
fi

# Same write-through-a-temp-file discipline as the export and the restore
# script: a half-written key file replacing a good one would be worse than not
# writing at all, and this runs at the moment there is no other copy to fall
# back on.
# Inside the umask, so both `sops` and `sops/age` are created 700 rather than
# only the leaf being chmodded afterwards. The parent used to end up 755 — or
# 777 under a permissive umask — which leaves a window where another local user
# can replace the `age` directory before the key lands in it.
(
	umask 077
	mkdir -p "$(dirname "$key_target")"
)
chmod 700 "$(dirname "$key_target")" 2>/dev/null || true
tmp="$key_target.tmp.$$"
cleanup() {
	[ -n "${tmp:-}" ] && rm -f "$tmp"
	# Load-bearing, for the reason the export's own trap says: a trap whose
	# last command is false takes the script's exit status with it, and the
	# test above is false on exactly the successful path.
	return 0
}
# EXIT and INT/TERM need different handlers. POSIX sh resumes at the point of
# interruption once a handler returns, so a Ctrl-C landing between the temp
# write and the `mv` would delete the temp file and then fall straight into the
# `mv`, which fails with a confusing `cannot stat` on the recovery path. The
# `return 0` below is right for EXIT — its comment explains why — and wrong for
# a signal, which must end the script.
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

if ! (
	umask 077
	printf '%s\n' "$plain" >"$tmp"
); then
	echo "dotfiles-secrets-restore: could not write $tmp" >&2
	exit 1
fi

if ! mv "$tmp" "$key_target"; then
	echo "dotfiles-secrets-restore: could not move the key into place" >&2
	exit 1
fi
tmp=""
chmod 600 "$key_target"

# Read back what was written, and compare it to what was meant to be written.
#
# The header of this script argues that a recorded fingerprint "proves nothing
# about the copy" — that verifying a record is not verifying an artifact. It
# made no equivalent assertion about its own write, on the one path where the
# backup is the only copy in existence. Now it does: derive the public half
# from the file on disk and require it to match the one derived from the
# plaintext a moment ago.
written_pub="$(age-keygen -y <"$key_target" 2>/dev/null || true)"
if [ "$written_pub" != "$pubkey" ]; then
	echo "dotfiles-secrets-restore: wrote $key_target, but reading it back does" >&2
	echo "not give the key that was decrypted. Do not trust this file." >&2
	echo "  expected: $pubkey" >&2
	echo "  on disk:  ${written_pub:-<unreadable>}" >&2
	exit 1
fi

echo
printf 'wrote %s\n' "$key_target"
echo "The vault is still the primary copy — this is a recovery, so put the key"
echo "back in Proton Pass as well if the vault is what was lost."
