#!/bin/sh
# Write a passphrase-encrypted offline copy of the secrets that cannot be
# re-issued, and record that it happened.
#
# Everything else in this repo assumes Proton Pass is reachable. This is the one
# thing that has to survive it not being: a forgotten password, a lost 2FA
# device or an account problem takes the SSH keys, the file secrets and the
# recovery path at the same moment, because they are all in the same account.
# README and docs/design-notes.md have said "keep an offline copy of anything
# you cannot re-issue" for as long as that has been true, and said it to a human
# who had to remember unprompted. This is the mechanism behind the sentence.
#
# What it deliberately is NOT: automatic. It needs a passphrase typed at a
# terminal, and the destination is wherever you say. An export that ran itself
# would need its passphrase stored somewhere, and the only somewhere available
# is the vault this exists to survive the loss of.
#
# Run by hand, and again whenever the age key is rotated —
# dotfiles-secrets-check tells you when that has happened and the copy is stale.
set -eu

usage() {
	cat <<'USAGE'
usage: dotfiles-secrets-export <destination-directory>

Writes a passphrase-encrypted copy of the unreissuable secrets to the given
directory (a mounted USB stick, an encrypted volume — anywhere off this
machine), and records the fact locally so dotfiles-secrets-check can tell you
when the copy has gone stale.

You are asked for a passphrase. Do not keep that passphrase only in Proton
Pass: that rebuilds the single point of failure this exists to break.
USAGE
}

case "${1:-}" in
--help | -h)
	usage
	exit 0
	;;
esac

if [ $# -ne 1 ]; then
	usage >&2
	exit 2
fi

dest="$1"

# The policy this script exists to encode, and the reason it is a declared list
# rather than a derived one: "can this be re-issued" is not a fact about the
# code, it is a judgement about each secret.
#
#   sops age keys       NO  — a new age key can be generated, but nothing
#                             already encrypted to the old one can be read
#                             again. This is the item that matters.
#
# Everything else in the vault is re-issuable, and listing it here would make
# the copy larger, more sensitive and no more useful:
#   gh hosts.yml        yes — revoke and mint a new token
#   devpod *            yes — fine-grained PATs, per repo
#   sugarrush config    yes — re-generate from the service
#   git signing key     yes — new key, update the allowed_signers
#   SSH keys            yes — painful (every authorized_keys, every forge) but
#                             possible, and they are item-type entries the
#                             export path below does not handle anyway
#
# Adding an entry here means deciding how the check fingerprints it, too. The
# age key is fingerprinted by its own public key, which is derivable from the
# private one and safe to write down; a different secret would need a different
# answer, not a sha256 of the secret itself.
age_item="sops age keys"

vault="Dotfiles"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
manifest="$state_dir/secrets-backup"

for tool in pass-cli age age-keygen; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "dotfiles-secrets-export: $tool is not installed" >&2
		exit 1
	fi
done

# `age -p` prompts for a passphrase and needs a terminal to do it. Failing here
# with a sentence is better than failing inside age with a confusing one, and it
# is the same reason the restore script probes for a TTY rather than hoping.
if [ ! -t 0 ]; then
	echo "dotfiles-secrets-export: needs a terminal to ask for a passphrase" >&2
	echo "Run it from an interactive shell." >&2
	exit 1
fi

if ! pass-cli info >/dev/null 2>&1; then
	echo "dotfiles-secrets-export: no Proton Pass session" >&2
	echo "Run 'pass-cli login' first — the copy is made from the vault." >&2
	exit 1
fi

if [ ! -d "$dest" ]; then
	echo "dotfiles-secrets-export: no such directory: $dest" >&2
	exit 1
fi

if [ ! -w "$dest" ]; then
	echo "dotfiles-secrets-export: not writable: $dest" >&2
	exit 1
fi

# Never inside a git work tree.
#
# The destination is whatever you type, and the shell you type it in is very
# often standing in a checkout — `dotfiles-secrets-export .` is one keystroke
# from correct and catastrophic. What lands is passphrase-encrypted, so this is
# not an immediate disclosure, but it is offline-crackable material published
# to a remote forever, and none of the machinery that would normally catch that
# looks at it: gitleaks matches key *shapes* and age armour is not one, the
# .gitignore covers directories this repo knows about, and the file is not
# named anything alarming.
#
# It is also, on its own terms, a pointless place to put it. The copy exists to
# survive losing the vault; a copy that lives in a repo whose whole purpose is
# to be reconstructible from that vault survives nothing.
#
# `rev-parse --show-toplevel` rather than looking for a .git entry: it walks
# upward the way git itself does, so a subdirectory five levels down is caught
# too, and it answers correctly inside a worktree or a submodule.
if command -v git >/dev/null 2>&1 &&
	git -C "$dest" rev-parse --show-toplevel >/dev/null 2>&1; then
	repo="$(git -C "$dest" rev-parse --show-toplevel 2>/dev/null || echo "$dest")"
	echo "dotfiles-secrets-export: $dest is inside the git repository at $repo" >&2
	echo "Refusing: an encrypted key committed and pushed is offline-crackable" >&2
	echo "forever, and a backup that lives in a repo does not survive losing the" >&2
	echo "vault anyway. Write it to removable media or an encrypted volume." >&2
	exit 1
fi

# Everything below writes through a temp file and moves it into place, for the
# same reason run_after_14-restore-secrets does: a half-written export that
# replaced a good one would be worse than no export at all, and this copy is by
# definition the only other one.
tmp=""
# `return 0` is load-bearing, not tidiness: an EXIT trap whose last command
# fails takes the script's exit status with it, and `[ -n "$tmp" ]` is false on
# every successful run — which is exactly when $tmp has been cleared. Without
# it, this reports failure precisely when it has just succeeded.
cleanup() {
	[ -n "$tmp" ] && rm -f "$tmp"
	return 0
}
trap cleanup EXIT INT TERM

plain="$(pass-cli item view --vault-name "$vault" --item-title "$age_item" \
	--field note 2>/dev/null || true)"
if [ -z "$plain" ]; then
	echo "dotfiles-secrets-export: could not read '$age_item' from the vault" >&2
	exit 1
fi

# The fingerprint recorded below. Derived through a pipe, never a file: the
# private key does not touch this machine's disk on the way past.
pubkey="$(printf '%s\n' "$plain" | age-keygen -y - 2>/dev/null || true)"
if [ -z "$pubkey" ]; then
	echo "dotfiles-secrets-export: '$age_item' is not a usable age identity" >&2
	exit 1
fi

target="$dest/dotfiles-age-key.age"
tmp="$dest/.dotfiles-age-key.age.$$"

echo "Encrypting '$age_item' with a passphrase you will be asked for now."
echo "Keep that passphrase somewhere that is NOT Proton Pass."
if ! printf '%s\n' "$plain" | (umask 077 && age -p -a >"$tmp"); then
	echo "dotfiles-secrets-export: encryption failed; nothing was written" >&2
	exit 1
fi

if [ ! -s "$tmp" ]; then
	echo "dotfiles-secrets-export: encryption produced an empty file; nothing written" >&2
	exit 1
fi

mv "$tmp" "$target"
tmp=""
# Removable media is often FAT, which has no permission bits to set. Worth
# asking for, not worth failing over — the file is passphrase-encrypted.
chmod 600 "$target" 2>/dev/null || true

# The manifest holds no secret material: a date, where the copy went, and the
# *public* half of the age key, which is what makes staleness detectable
# without the vault or the backup being present.
mkdir -p "$state_dir"
chmod 700 "$state_dir" 2>/dev/null || true
tmp="$manifest.$$"
{
	echo "# Written by dotfiles-secrets-export. No secret material here: the"
	echo "# public key below is derivable from the private one, not the reverse."
	echo "date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	echo "destination=$target"
	echo "age_public_key=$pubkey"
} >"$tmp"
mv "$tmp" "$manifest"
tmp=""

echo "wrote $target"
echo "recorded $manifest"
echo
echo "Verify you can actually read it back — an untested backup is a guess:"
echo "  dotfiles-secrets-restore '$target'"
echo
echo "Not 'age -d': that prints the private key into your scrollback. The"
echo "command above decrypts it, checks it, and shows only the public half."
