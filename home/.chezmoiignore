ghostty.terminfo
{{ if eq (includeTemplate "is-container" .) "true" -}}
# Picks which terminal emulator Super+Return opens, which only means something
# on a machine with a display. The container test lives in
# .chezmoitemplates/is-container, shared with the host-packages script and the
# devpod external, so the gates can't drift apart.
.config/xdg-terminals.list
# Omarchy's screensaver branding. A container has no omarchy, no display and
# no screensaver to brand, so the file would just sit there unread.
.config/omarchy/branding/screensaver.txt
{{ end -}}
{{ if or (eq (includeTemplate "is-container" .) "true") (eq (includeTemplate "is-devpod-platform" .) "false") -}}
# The devpod wrapper only means something where the binary it fronts is
# installed, and .chezmoiexternals/devpod.toml skips both cases: inside a
# container (DevPod drives containers, it doesn't run in one) and on a platform
# with no linux-amd64 release asset. Same two templates, so the gates can't
# drift apart.
.local/bin/devpod
{{ end -}}
{{ if eq (includeTemplate "is-container" .) "true" -}}
# The Proton Pass key loader is host-only for the same reason: no pass-cli and
# no session inside a container, which gets the keys from the forwarded agent.
.local/bin/proton-ssh-load
# The health check is host-only for exactly that reason too. It probes for a
# container at runtime as well, because the source-tree copy is reachable from
# a devcontainer working on this repo.
.local/bin/dotfiles-secrets-check
# And the offline export, which reads the same vault to write the copy. A
# container has nothing to export and nowhere to export it to.
.local/bin/dotfiles-secrets-export
# And its counterpart, for the same reason: a container has no vault to restore
# into and no removable medium to read the copy from.
.local/bin/dotfiles-secrets-restore
# The herdr shim exists for Moshi's launcher, which is host-only — same gate as
# .chezmoiexternals/moshi-hook.toml. herdr itself is a mise tool and is on PATH
# in a container anyway; what a container has no use for is a second name for it
# on a PATH no phone will ever export. See docs/design-notes.md, "Moshi's
# launcher cannot see a mise shim".
.local/bin/herdr
{{ end -}}
