ghostty.terminfo
{{ if eq (includeTemplate "is-container" .) "true" -}}
# Picks which terminal emulator Super+Return opens, which only means something
# on a machine with a display. The container test lives in
# .chezmoitemplates/is-container, shared with the host-packages script and the
# devpod external, so the gates can't drift apart.
.config/xdg-terminals.list
# Omarchy's screensaver branding. A container has no omarchy, no display and
# no screensaver to brand, so the file would just sit there unread.
.config/omarchy/branding/screensaver.txt
# Hyprland's monitor scaling, for the same reason and then some: a container
# has no compositor to read it, no display to scale, and Hyprland would never
# load the file anyway. The keybindings and the look-and-feel block are managed
# for the same reason monitors.lua is -- they are customised, and a migration
# has replaced a hand-tuned hypr file here before with no backup -- and are
# equally useless to a container.
.config/hypr/monitors.lua
.config/hypr/bindings.lua
.config/hypr/looknfeel.lua
# The bar widgets. A container has no omarchy shell to load one into. The
# ssh-agent widget's `agent-status` script is not ignored: it costs nothing, and
# a devcontainer working on this repo can still run it by hand.
.config/omarchy/plugins/lokilabs.ssh-agent
.config/omarchy/plugins/lokilabs.workspace
{{ end -}}
{{ if or (eq (includeTemplate "is-container" .) "true") (eq (includeTemplate "is-devpod-platform" .) "false") -}}
# The devpod wrapper only means something where the binary it fronts is
# installed, and .chezmoiexternals/devpod.toml skips both cases: inside a
# container (DevPod drives containers, it doesn't run in one) and on a platform
# with no linux-amd64 release asset. Same two templates, so the gates can't
# drift apart.
.local/bin/devpod
{{ end -}}
{{ if eq (includeTemplate "is-container" .) "true" -}}
# The Proton Pass key loader is host-only for the same reason: no pass-cli and
# no session inside a container, which gets the keys from the forwarded agent.
.local/bin/proton-ssh-load
# The health check is host-only for exactly that reason too. It probes for a
# container at runtime as well, because the source-tree copy is reachable from
# a devcontainer working on this repo.
.local/bin/dotfiles-secrets-check
# And the offline export, which reads the same vault to write the copy. A
# container has nothing to export and nowhere to export it to.
.local/bin/dotfiles-secrets-export
# And its counterpart, for the same reason: a container has no vault to restore
# into and no removable medium to read the copy from.
.local/bin/dotfiles-secrets-restore
# The herdr shim exists for Moshi's launcher, which is host-only — same gate as
# .chezmoiexternals/moshi-hook.toml. herdr itself is a mise tool and is on PATH
# in a container anyway; what a container has no use for is a second name for it
# on a PATH no phone will ever export. See docs/design-notes.md, "Moshi's
# launcher cannot see a mise shim".
.local/bin/herdr
# The offline copy is a copy of the age key, and a work machine has none: the
# Work vault holds no `sops age keys`, so there is nothing to export and nothing
# to read back. Both halves go, or a work machine ships two commands whose only
# possible outcome is an error about a missing vault item.
.local/bin/dotfiles-secrets-export
.local/bin/dotfiles-secrets-restore
{{ end -}}
{{ if not (contains " personal " (includeTemplate "profiles" .)) -}}
# Personal-only, on the same reasoning as the container block above: these are
# not merely useless elsewhere, they belong to one life.
#
# repos-sync clones a hardcoded list of six personal repositories. On a work
# machine it is a command that does the wrong thing rather than nothing, which
# is worse than its absence.
.local/bin/repos-sync
# The monitor rule is a catch-all pinned to the scale one 34" ultrawide wants,
# which is a fact about a desk rather than about Omarchy. A work machine has
# different displays, so it keeps Omarchy's `scale = "auto"` and lets the bar
# widget resolve it — wrong-but-confident scaling is worse than none.
.config/hypr/monitors.lua
# The moshi shim, alongside .chezmoiexternals/moshi-hook.toml and
# run_after_22-enable-moshi-hook, which gate on the same profile: a paired phone
# can approve tool calls and read what the agent is doing.
.local/bin/herdr
# The offline copy is a copy of the age key, and a work machine has none: the
# Work vault holds no `sops age keys`, so there is nothing to export and nothing
# to read back. Both halves go, or a work machine ships two commands whose only
# possible outcome is an error about a missing vault item.
.local/bin/dotfiles-secrets-export
.local/bin/dotfiles-secrets-restore
{{ end -}}
