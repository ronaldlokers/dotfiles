{{ if eq (includeTemplate "is-container" .) "true" -}}
# Picks which terminal emulator Super+Return opens, which only means something
# on a machine with a display. The container test lives in
# .chezmoitemplates/is-container, shared with the host-packages script and the
# devpod external, so the gates can't drift apart.
.config/xdg-terminals.list
# Omarchy's screensaver branding. A container has no omarchy, no display and
# no screensaver to brand, so the file would just sit there unread.
.config/omarchy/branding/screensaver.txt
{{ end -}}
{{ if or (eq (includeTemplate "is-container" .) "true") (eq (includeTemplate "is-devpod-platform" .) "false") -}}
# The devpod wrapper only means something where the binary it fronts is
# installed, and .chezmoiexternals/devpod.toml skips both cases: inside a
# container (DevPod drives containers, it doesn't run in one) and on a platform
# with no linux-amd64 release asset. Same two templates, so the gates can't
# drift apart.
.local/bin/devpod
{{ end -}}
