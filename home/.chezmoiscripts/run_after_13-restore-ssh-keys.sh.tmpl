#!/bin/sh
# Restore SSH private keys from Proton Pass onto a machine that doesn't have
# them yet. Proton is the source of truth; ~/.ssh is the working copy.
#
# Only ever *creates* what is missing. An existing key is left alone, so the
# steady state is a no-op that touches neither the network nor the vault — and
# an expired session, an offline laptop or a Proton outage cannot break a
# machine that is already set up. The cost lands entirely on a fresh machine,
# which needs `pass-cli login` once.
#
# run_after rather than run_before: pass-cli arrives as a host-only external
# (.chezmoiexternals/pass-cli.toml) and externals are applied before the after
# scripts, so this is the first point in an apply where the binary exists. On
# the very first apply of a fresh machine there is no session yet, so this
# skips with a message and the next apply finishes the job — the same
# two-phase shape run_before_00-unlock-secrets uses for the age identity.
#
# Deliberately silent about key material: nothing is echoed, no `set -x`, and
# the private key goes straight from pass-cli's stdout into a 0600 file under
# `umask 077`. It never reaches the process arguments, where `ps` could read it.
set -eu

# Rendered into shell variables rather than branched on in the template itself:
# `mise run lint` shellchecks these files unrendered, and a top-level Go action
# is not parseable shell. Same pattern, and the same unavoidable pragmas, as
# run_after_20-install-host-packages — shellcheck sees a literal brace pair and
# an assignment it cannot follow.
# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC1083
has_proton={{ includeTemplate "has-proton-session" . }}
vault="Dotfiles"

# Containers have no pass-cli and no Proton session by design. Git inside a
# container uses the forwarded ssh-agent instead — see the design notes.
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
	exit 0
fi

pat_file="$HOME/.config/pass-cli-bootstrap-pat"

# Log in with a personal access token when there is no interactive session.
#
# The token comes from the environment on a fresh machine
# (PROTON_PASS_PERSONAL_ACCESS_TOKEN=… chezmoi apply) and is cached at
# $pat_file afterwards, so later applies re-authenticate on their own when the
# session lapses. It is scoped viewer on the Dotfiles vault and nothing else,
# and it expires — `pass-cli pat renew` when it does.
#
# Passed through the environment, never as `--personal-access-token`: a flag
# value is visible in `ps` to every user on the machine.
pat_login() {
	command -v pass-cli >/dev/null 2>&1 || return 1

	pat="${PROTON_PASS_PERSONAL_ACCESS_TOKEN:-}"
	from_env=1
	if [ -z "$pat" ] && [ -r "$pat_file" ]; then
		pat="$(cat "$pat_file")"
		from_env=0
	fi
	[ -n "$pat" ] || return 1

	PROTON_PASS_PERSONAL_ACCESS_TOKEN="$pat" pass-cli login >/dev/null 2>&1 || return 1

	# Only worth caching once it is known to work.
	if [ "$from_env" = 1 ]; then
		mkdir -p "$(dirname "$pat_file")"
		(
			umask 077
			printf '%s\n' "$pat" >"$pat_file"
		)
		echo "[ssh-keys] cached the Proton Pass token at ${pat_file#"$HOME"/}"
	fi
	unset pat
	return 0
}

# shellcheck disable=SC2154
if [ "$has_proton" != "true" ] && ! pat_login; then
	# No pass-cli, no session and no usable token. Only say so when a key is
	# actually missing: on an already-provisioned machine this script has
	# nothing to do and the message would be noise on every apply.
	for key in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ed25519_signing" "$HOME/.ssh/aur"; do
		if [ ! -f "$key" ]; then
			echo "[ssh-keys] $(basename "$key") is missing and Proton Pass is unavailable."
			echo "[ssh-keys] Either run 'pass-cli login', or re-apply with"
			echo "[ssh-keys] PROTON_PASS_PERSONAL_ACCESS_TOKEN set (token: Dotfiles vault,"
			echo "[ssh-keys] item 'dotfiles: bootstrap PAT')."
			break
		fi
	done
	exit 0
fi

restore() {
	title="$1"
	target="$2"

	[ -f "$target" ] && return 0

	mkdir -p "$HOME/.ssh"
	chmod 700 "$HOME/.ssh"

	# `--field private_key` rather than `--output json | jq`: this script runs
	# before run_onchange_after_install_packages (scripts execute in name
	# order, and "run_after_" sorts before "run_onchange_"), so on a fresh
	# machine mise has not installed jq yet.
	if ! (
		umask 077
		pass-cli item view --vault-name "$vault" --item-title "$title" \
			--field private_key >"$target.tmp" 2>/dev/null
	); then
		rm -f "$target.tmp"
		echo "[ssh-keys] could not read '$title' from Proton Pass; skipping $(basename "$target")" >&2
		return 0
	fi

	# A truncated or empty key is worse than no key: ssh would fail with a
	# parse error rather than falling back to another identity.
	if ! ssh-keygen -y -f "$target.tmp" >/dev/null 2>&1; then
		rm -f "$target.tmp"
		echo "[ssh-keys] '$title' did not contain a usable private key; skipping $(basename "$target")" >&2
		return 0
	fi

	mv "$target.tmp" "$target"
	chmod 600 "$target"
	# Derive the public half rather than storing it twice — but only when it is
	# absent. id_ed25519_signing.pub is a managed file (git needs it for
	# gpg.ssh.allowedSignersFile), and writing it here would fight chezmoi.
	if [ ! -f "$target.pub" ]; then
		ssh-keygen -y -f "$target" >"$target.pub"
		chmod 644 "$target.pub"
	fi
	echo "[ssh-keys] restored $(basename "$target") from Proton Pass"
}

restore "dotfiles: ssh auth key" "$HOME/.ssh/id_ed25519"
restore "dotfiles: git signing key" "$HOME/.ssh/id_ed25519_signing"
restore "dotfiles: aur ssh key" "$HOME/.ssh/aur"
