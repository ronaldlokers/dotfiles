#!/bin/bash
set -euo pipefail

# Desktop applications for the host: things needing a display or a system
# package manager. CLI tools go in dot_config/mise/config.toml instead.
#
# A plain run_after, not run_onchange, so a skipped run is retried later rather
# than remembered as done. Arch-only; exits cleanly elsewhere.

# Shipped by the distro's own repos.
REPO_PACKAGES=(
	discord
	# Needs a display, so not mise. Which terminal Super+Return opens is set
	# by dot_config/xdg-terminals.list.
	ghostty
	obsidian
	proton-vpn-gtk-app
	prusa-slicer
	rpi-imager
	signal-desktop
	# Mesh VPN. Host-only: owns machine-wide routing, which containers inherit.
	tailscale
	# Touch-to-sudo; pulls in libfido2, also needed for ed25519-sk keys.
	pam-u2f
	# YubiKey: pcscd smartcard daemon plus the ykman CLI.
	pcsclite
	yubikey-manager
	# udev rules for the OTP/HID interface; without them ykman otp fails with a
	# misleading "connection type not supported".
	yubikey-personalization
	# The age PIV plugin. Comes from pacman rather than mise because upstream's
	# releases carry darwin and windows assets only — there is no linux binary
	# for a release-based backend to fetch.
	age-plugin-yubikey
	# The login shell, and the one this repo actually configures — dot_zshrc holds
	# the prompt, autosuggestions, fzf-tab and completion setup, while dot_bashrc
	# is only a fallback. From pacman, not mise: a login shell must be in
	# /etc/shells and running before mise activates.
	zsh
)

# AUR packages. Building these runs upstream PKGBUILDs as arbitrary code, so
# curate the list by hand. yay/paru check binary repos first, which also covers
# packages served from a custom repo on some machines.
AUR_PACKAGES=(
	bambustudio-bin
	chirp-next
	claude-desktop
	proton-pass-bin
	spotify
	winbox
	zen-browser-bin
)

# Containers get none of this. Unquoted on purpose, and the pragmas are
# unavoidable: CI shellchecks the template, not the rendered script.
# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
	exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
	echo "[packages] no pacman on this system; skipping host packages." >&2
	exit 0
fi

# Probe with `sudo -n` first: a non-interactive apply has no TTY, and a
# password prompt would hang forever.
if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
	echo "[packages] no TTY and sudo needs a password; skipping host packages." >&2
	echo "[packages] Run 'chezmoi apply' from an interactive shell to install them." >&2
	exit 0
fi

missing() {
	! pacman -Q "$1" >/dev/null 2>&1
}

failed=()

# One transaction: shared dependencies resolve once, one sudo prompt.
pending=()
for pkg in "${REPO_PACKAGES[@]}"; do
	missing "$pkg" && pending+=("$pkg")
done

if [ ${#pending[@]} -gt 0 ]; then
	echo "[packages] installing from repos: ${pending[*]}" >&2
	# --needed so an already-satisfied package is skipped rather than reinstalled.
	sudo pacman -S --needed --noconfirm "${pending[@]}" || true
	# pacman can exit 0 having skipped a package; trust the database.
	for pkg in "${pending[@]}"; do
		missing "$pkg" && failed+=("$pkg")
	done
fi

# yay and paru are interchangeable here. Absolute path, because the build
# below runs on a stripped PATH.
aur_helper=""
for helper in yay paru; do
	if aur_helper="$(command -v "$helper" 2>/dev/null)"; then
		break
	fi
	aur_helper=""
done

# Build on a system-only PATH: mise's shims shadow /usr/bin, so a PKGBUILD
# calling python/node/ruby would get a mise interpreter that cannot see its
# own makedepends — or worse, bake mise paths into the package.
SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin"

pending=()
for pkg in "${AUR_PACKAGES[@]}"; do
	missing "$pkg" && pending+=("$pkg")
done

if [ ${#pending[@]} -gt 0 ]; then
	if [ -z "$aur_helper" ]; then
		echo "[packages] no AUR helper (yay/paru); skipping: ${pending[*]}" >&2
	else
		# One at a time here, unlike the repo batch: a single failing PKGBUILD
		# aborts the whole yay transaction, and one broken AUR package shouldn't
		# cost the other six.
		for pkg in "${pending[@]}"; do
			echo "[packages] building from AUR: $pkg" >&2
			env PATH="$SYSTEM_PATH" "$aur_helper" -S --needed --noconfirm "$pkg" || true
			missing "$pkg" && failed+=("$pkg")
		done
	fi
fi

# Group memberships a package needs to be usable but can't grant itself, since
# only the admin knows which human should get them. chirp talks to radios over a
# USB serial adapter, and /dev/ttyUSB* is owned by the uucp group on Arch —
# without it chirp installs fine and then can't open the port.
#
# Keyed on the package actually being installed: a machine that skipped or
# dropped chirp shouldn't silently pick up device access it has no use for.
declare -A PACKAGE_GROUPS=(
	[chirp-next]=uucp
)

# `id -un`, not $USER: chezmoi runs scripts with whatever environment it
# inherited, and an unset $USER under `set -u` would abort the whole script.
user="$(id -un)"

for pkg in "${!PACKAGE_GROUPS[@]}"; do
	group="${PACKAGE_GROUPS[$pkg]}"
	missing "$pkg" && continue
	# The group is created by the package that needs it, so it can be absent on a
	# machine where installation failed.
	getent group "$group" >/dev/null 2>&1 || continue
	id -nG "$user" | tr ' ' '\n' | grep -qx "$group" && continue

	echo "[packages] adding $user to '$group' (needed by $pkg)" >&2
	if sudo usermod -aG "$group" "$user"; then
		# usermod edits /etc/group, but the running session's credentials were
		# fixed at login — nothing already open picks this up.
		echo "[packages] log out and back in for '$group' membership to take effect." >&2
	else
		echo "[packages] failed to add $user to '$group'; run: sudo usermod -aG $group $user" >&2
	fi
done

# System units a package ships but leaves disabled. Same shape as
# PACKAGE_GROUPS, and keyed on the package for the same reason: a machine that
# never installed the package has no business running its daemon.
#
# pcscd is socket-activated, so enabling the *socket* is what matters — the
# daemon then starts on the first smartcard access and exits when idle. Enabling
# pcscd.service directly would keep it resident for nothing.
declare -A PACKAGE_UNITS=(
	[pcsclite]=pcscd.socket
	# tailscaled only brings the daemon up. Joining a tailnet still needs
	# `sudo tailscale up`, which opens a browser to authenticate — deliberately
	# not automated here, since the alternative is an auth key, and that is a
	# credential this repo would then have to hold.
	[tailscale]=tailscaled.service
)

for pkg in "${!PACKAGE_UNITS[@]}"; do
	unit="${PACKAGE_UNITS[$pkg]}"
	missing "$pkg" && continue
	# System units, not --user: this needs a real init, which a container
	# generally hasn't got. The container gate above already returned, so
	# reaching here means a host — but systemctl can still be a shim.
	command -v systemctl >/dev/null 2>&1 || continue
	systemctl is-enabled --quiet "$unit" 2>/dev/null && continue

	echo "[packages] enabling $unit (needed by $pkg)" >&2
	sudo systemctl enable --now "$unit" \
		|| echo "[packages] failed to enable $unit; run: sudo systemctl enable --now $unit" >&2
done

# The login shell. Same shape as the two blocks above — a side effect the package
# can't apply to itself, keyed on the package actually being installed. Also
# keyed on the shell being listed in /etc/shells, since chsh refuses anything
# that isn't, and the zsh package is what adds that entry.
if ! missing zsh; then
	zsh_path="$(command -v zsh || true)"
	current_shell="$(getent passwd "$user" | cut -d: -f7)"

	if [ -n "$zsh_path" ] && [ "$current_shell" != "$zsh_path" ] \
		&& grep -qxF "$zsh_path" /etc/shells; then
		echo "[packages] setting $user's login shell to $zsh_path" >&2
		if sudo chsh -s "$zsh_path" "$user"; then
			# Like the group change above, a session that's already open keeps the
			# shell it started with.
			echo "[packages] open a new terminal for the shell change to take effect." >&2
		else
			echo "[packages] failed to set login shell; run: chsh -s $zsh_path" >&2
		fi
	fi
fi

# Best-effort by design: report and exit 0. A hard failure here would block
# every later step of the apply over one flaky AUR build, and because this is a
# plain run_after the next apply retries whatever didn't land.
if [ ${#failed[@]} -gt 0 ]; then
	echo "[packages] failed to install: ${failed[*]}" >&2
	echo "[packages] re-run 'chezmoi apply', or install by hand to see the error." >&2
fi
