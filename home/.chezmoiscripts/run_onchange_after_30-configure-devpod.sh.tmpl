#!/bin/sh
# DevPod's host-side configuration: which provider runs containers, which IDE it
# opens, and the context options every workspace inherits. The binary comes from
# .chezmoiexternals/devpod.toml.
#
# Driven through the CLI: DevPod writes ~/.devpod/config.yaml itself, so a
# managed copy would show as permanent drift.
#
# run_onchange, not run_after, because a settled rerun costs 2.2s. The cost is
# that it does not reconverge — after `rm -rf ~/.devpod`, recovery needs
# `chezmoi state delete-bucket` or an edit to this file.
set -eu

# Host-only, same gate as the external. The pragmas are unavoidable: CI lints
# this template, not the rendered script.
# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
    echo "Inside a container, skipping DevPod configuration." >&2
    exit 0
fi

# Same platform gate as the external: the asset is linux-amd64 only, so this
# tells "no binary by design" apart from "binary missing".
# shellcheck disable=SC1083
supported_platform={{ includeTemplate "is-devpod-platform" . }}

# Not `command -v`: $HOME/.local/bin is on PATH in an interactive shell but not
# during a clean-HOME apply, where this script runs right after the external has
# put the binary there.
#
# A missing binary means two different things depending on the platform:
#   - unsupported platform ($supported_platform above is false): the external
#     deliberately skipped it, so there was never going to be a binary here.
#     That's not an error — exit 0 so chezmoi records this script as done
#     instead of retrying forever on a machine that can never satisfy it.
#   - supported platform: the external guarantees the binary here, so its
#     absence means that guarantee broke. Exiting non-zero is what matters:
#     chezmoi only records a run_onchange script as done on exit 0, and this
#     script's rendered content doesn't change on a stable host, so a silent
#     `exit 0` here would leave DevPod unconfigured forever with no later
#     apply retrying it.
devpod="$HOME/.local/bin/devpod"
if [ ! -x "$devpod" ]; then
    # shellcheck disable=SC2154
    if [ "$supported_platform" != "true" ]; then
        echo "no devpod binary for this platform (.chezmoi.os/.chezmoi.arch) —" >&2
        echo "the external skipped it on purpose; nothing to configure here." >&2
        exit 0
    fi
    echo "no devpod binary at $devpod — the external should have" >&2
    echo "installed it; not recording this script as done." >&2
    exit 1
fi

# `provider use` fails when the provider was never added, so it doubles as the
# "is it already there?" test. `provider add` defaults to --use, so the fallback
# path also makes docker the default. The alternative — parsing `provider list
# --output json` — would need jq, which isn't guaranteed to exist yet.
# docker is internal to the binary ("source": {"internal": true}), so adding it
# resolves locally and needs no network.
"$devpod" provider use docker >/dev/null 2>&1 || "$devpod" provider add docker

# Terminal-only workflow: DevPod should start the container and stop, not try to
# launch an editor.
"$devpod" ide use none

# Context options, inherited by every workspace:
# - DOTFILES_URL is what makes a fresh container run this very repo's apply. SSH
#   rather than HTTPS because the container has the agent forwarded in.
# - GIT_SSH_SIGNATURE_FORWARDING off: the forwarded agent holds the auth key, and
#   asking it to sign commits inside the container fails rather than falling back.
# - DOTFILES_SCRIPT names this repo's installer outright. Left empty, DevPod
#   guesses: it probes install.sh, install, bootstrap.sh, bootstrap,
#   script/bootstrap and setup.sh before reaching setup, logging a "Failed to
#   make install script ... not found" line for each miss. Every one of those is
#   a script this repo has deliberately never had, so the noise reports nothing.
"$devpod" context set-options \
    -o DOTFILES_URL=git@github.com:ronaldlokers/dotfiles.git \
    -o DOTFILES_SCRIPT=setup \
    -o GIT_SSH_SIGNATURE_FORWARDING=false
