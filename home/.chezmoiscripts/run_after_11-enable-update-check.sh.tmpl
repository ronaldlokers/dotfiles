#!/bin/sh
# Enable the timer that notifies when this machine's dotfiles are behind the
# remote. Same shape as the ssh-agent enable script next door, including why it
# is a plain `run_after`: a run_onchange records its hash on the exit 0 that
# means "no systemd here, did nothing", so one session-less apply skipped this
# timer for the life of the machine. Running every apply is what lets a later
# one finish the job.
set -eu

pending() {
	command -v dotfiles-pending >/dev/null 2>&1 && dotfiles-pending "$@" || true
}
pending clear update-check

# Only where a systemd user manager is running — hosts, not devpod containers.
# Probe the manager's own socket rather than systemctl's exit code: devcontainer
# images ship a systemctl shim that exits 0 while printing "systemd is not
# running", so trusting the exit code enables a timer that will never fire.
if [ ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/systemd/private" ]; then
	pending set update-check "no systemd user session; re-run chezmoi apply in a login session"
    echo "No systemd user session, skipping update-check timer." >&2
    exit 0
fi

# Guarded for the same reason the enable below is, and it was the one call here
# that was not. A non-zero exit from a run_ script does not merely skip this
# unit, it aborts the whole apply — chezmoi stops, and every script numbered
# after this one (restoring the file secrets, installing the host packages,
# configuring DevPod) never runs. A user manager that refuses a reload is not a
# reason to leave the machine half-provisioned.
if ! systemctl --user daemon-reload; then
    echo "Could not reload the systemd user manager; continuing." >&2
fi

# systemctl --user talks to the running user manager, which resolves unit paths
# from its own environment — not from whatever HOME this script inherited. When
# an apply runs against a redirected HOME (CI's clean-HOME bootstrap, any
# throwaway-HOME test) the unit lands somewhere the manager will never look, and
# `enable` fails with "Unit file ... does not exist".
#
# That is a property of the test setup, not a broken machine, so don't fail the
# apply over it. Check visibility first and say plainly why it was skipped.
if ! systemctl --user cat dotfiles-update-check.timer >/dev/null 2>&1; then
	pending set update-check "unit is not visible to the user manager; apply from its owning HOME"
    echo "Timer unit not visible to the user manager, skipping enable." >&2
    echo "Expected when applying to a HOME the manager doesn't own." >&2
    exit 0
fi

# The timer, not the service: the service is oneshot and pulled in by the timer.
# Enabling the service itself would run a check on every login instead.
#
# Best-effort for the same reason — a notification timer is not worth aborting
# an apply for, and this script re-runs whenever its inputs change.
if ! systemctl --user enable --now dotfiles-update-check.timer; then
	pending set update-check "systemctl could not enable dotfiles-update-check.timer"
    echo "Could not enable dotfiles-update-check.timer; continuing." >&2
    echo "Enable it by hand with: systemctl --user enable --now dotfiles-update-check.timer" >&2
fi
