#!/bin/sh
# Enable the systemd user ssh-agent so its socket actually exists — the
# old "activate once per machine" manual step was easy to forget, which
# left SSH_AUTH_SOCK (then set via environment.d) pointing at a dead
# socket and broke DevPod's agent forwarding from Omarchy.
#
# A plain `run_after`, not a `run_onchange`, for the same reason the host
# package script is one: chezmoi records a run_onchange script's hash the moment
# it exits 0 — including the exit 0 that means "no systemd here, did nothing" —
# and never runs it again until the script itself changes. An apply from a
# session-less context (a bootstrap over ssh, a first apply before the display
# manager has started one) therefore skipped this permanently and silently.
# Running every apply costs one probe and two systemctl calls, and lets a later
# apply finish the job.
set -eu

pending() {
	command -v dotfiles-pending >/dev/null 2>&1 && dotfiles-pending "$@" || true
}
pending clear ssh-agent

# Only where a systemd user manager is running (hosts, not devpod
# containers — there the agent is forwarded in, not started locally).
# Probe the manager's own socket, not `systemctl` exit codes: devcontainer
# images ship a systemctl shim that exits 0 with a "systemd is not
# running" notice.
if [ ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/systemd/private" ]; then
	pending set ssh-agent "no systemd user session; re-run chezmoi apply in a login session"
    echo "No systemd user session, skipping ssh-agent service enable." >&2
    exit 0
fi

# Guarded for the same reason the enable below is, and it was the one call here
# that was not. A non-zero exit from a run_ script does not merely skip this
# unit, it aborts the whole apply — chezmoi stops, and every script numbered
# after this one (restoring the file secrets, installing the host packages,
# configuring DevPod) never runs. A user manager that refuses a reload is not a
# reason to leave the machine half-provisioned.
if ! systemctl --user daemon-reload; then
    echo "Could not reload the systemd user manager; continuing." >&2
fi

# systemctl --user talks to the running user manager, which resolves unit paths
# from its own environment — not from whatever HOME this script inherited. When
# an apply runs against a redirected HOME (a throwaway-HOME verify, any test)
# the unit lands somewhere the manager will never look, while $XDG_RUNTIME_DIR
# still points at the developer's real session. Enabling regardless is worse
# than a failure: it succeeds, against the machine that was only supposed to be
# running the check.
#
# Same guard, same wording as the two sibling scripts next door.
if ! systemctl --user cat ssh-agent.service >/dev/null 2>&1; then
	pending set ssh-agent "unit is not visible to the user manager; apply from its owning HOME"
    echo "Unit not visible to the user manager, skipping enable." >&2
    echo "Expected when applying to a HOME the manager doesn't own." >&2
    exit 0
fi

# Best-effort, like the siblings: a failure here must cost the ssh-agent unit
# and not every script queued behind it. CI's host-ssh-agent job asserts the
# unit is actually active afterwards, so a silently swallowed failure still
# fails the build there.
if ! systemctl --user enable --now ssh-agent.service; then
	pending set ssh-agent "systemctl could not enable ssh-agent.service"
    echo "Could not enable ssh-agent.service; continuing." >&2
    echo "Enable it by hand with: systemctl --user enable --now ssh-agent.service" >&2
fi
