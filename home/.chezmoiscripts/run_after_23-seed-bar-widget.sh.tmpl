#!/bin/sh
# Put this repo's own bar widgets on the Omarchy bar, once each.
#
# ~/.config/omarchy/shell.json is deliberately not managed: `omarchy bar`,
# `omarchy theme` and the plugin commands all write to it, and a managed copy
# would revert whatever the last one did -- the fight docs/design-notes.md
# describes under "Co-owned configuration files". The widgets still have to
# arrive on a new machine without being typed in by hand, so they are seeded
# rather than asserted.
#
# A plain `run_after`, not a `run_onchange`, for the reason the enable scripts
# next door are: chezmoi records a run_onchange script's hash the moment it
# exits 0, including the exit 0 that means "nothing here to act on". This
# script has two such conditions -- no shell.json yet, no jq yet -- and either
# would have marked the seeding done for the life of the machine.
#
# The memory is a state file instead, one line per widget: `<id> <spec>`. Per
# widget, not one line for all of them, because a shared spec would mean that
# editing one widget's entry here resurrected another the user had removed on
# purpose -- a change to one thing undoing a decision about another.
#
#   - spec unchanged and already recorded: do nothing. A widget moved or
#     removed by hand stays that way; the repo has had its say.
#   - spec changed, or never recorded: seed, then record.
#   - could not act: record nothing, and the next apply tries again.
set -eu

# A container has no omarchy shell, no bar and no display to put one on.
# Rendered into a variable rather than wrapping the body in a template `if`,
# the way the host-packages script does it: CI shellchecks the template, not
# the rendered script, and a bare template action at statement level does not
# parse as shell.
# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
	exit 0
fi

shell_json="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
state_file="$state_dir/bar-widget-seeded"

# The widgets, and the specs the state file remembers. Changing anything on one
# of these lines -- the entry, where it sits, how it gets there -- is what makes
# the next apply seed that one again.
#
# `before` keeps the anchor and sits in front of it. `replace` takes the
# anchor's place and drops it: lokilabs.workspace is a clone of
# omarchy.workspaces, not an addition to it, and both on one bar would paint
# the same spaces twice.
widget_ids="lokilabs.ssh-agent lokilabs.workspace"

spec_for() {
	case "$1" in
	lokilabs.ssh-agent)
		entry='{"id":"lokilabs.ssh-agent","alwaysShow":true}'
		section="right"
		anchor="omarchy.power"
		mode="before"
		;;
	lokilabs.workspace)
		entry='{"id":"lokilabs.workspace","monitorColors":["bright_green","bright_magenta"]}'
		section="left"
		anchor="omarchy.workspaces"
		mode="replace"
		;;
	*)
		return 1
		;;
	esac
	spec="$entry $mode=$anchor section=$section"
}

# Nothing to merge into. Not an error: omarchy writes this file itself, and a
# machine part-way through its first bootstrap genuinely has none yet. Recording
# nothing is the point -- the next apply finds it and seeds then.
[ -f "$shell_json" ] || exit 0

# Same reasoning. jq arrives with the packages a later script installs, so the
# first apply on a fresh machine can legitimately run without it.
command -v jq >/dev/null 2>&1 || exit 0

recorded_spec() {
	[ -r "$state_file" ] || return 0
	while read -r line_id line_spec; do
		if [ "$line_id" = "$1" ]; then
			printf '%s\n' "$line_spec"
			return 0
		fi
	done <"$state_file"
}

# Rewrites the file with this widget's line replaced. Lines for ids no longer in
# the table go too, which is also how the single-line format this script used
# before gets cleaned up rather than lingering forever as junk.
state_put() {
	mkdir -p "$state_dir"
	tmp="$state_file.tmp.$$"
	: >"$tmp"
	if [ -r "$state_file" ]; then
		while read -r line_id line_spec; do
			[ "$line_id" = "$1" ] && continue
			for known in $widget_ids; do
				if [ "$line_id" = "$known" ]; then
					printf '%s %s\n' "$line_id" "$line_spec" >>"$tmp"
					break
				fi
			done
		done <"$state_file"
	fi
	printf '%s %s\n' "$1" "$2" >>"$tmp"
	mv -f "$tmp" "$state_file"
}

for widget_id in $widget_ids; do
	spec_for "$widget_id"

	# Already said this one.
	[ "$(recorded_spec "$widget_id")" = "$spec" ] && continue

	# Ours already there: update in place, which keeps whatever position it has
	# been moved to. In replace mode the anchor goes even then, so a bar holding
	# both ends up holding one.
	#
	# Otherwise: take the anchor's index, or append when the anchor is gone too
	# -- a section with neither is not a reason to skip the widget entirely.
	merged="$(jq \
		--arg id "$widget_id" \
		--argjson entry "$entry" \
		--arg anchor "$anchor" \
		--arg mode "$mode" \
		--arg section "$section" '
		.bar.layout[$section] = (
			(.bar.layout[$section] // [])
			| if any(.[]; .id == $id) then
				map(if .id == $id then $entry else . end)
				| if $mode == "replace" then map(select(.id != $anchor)) else . end
			else
				(map(.id) | index($anchor)) as $at
				| if $at == null then . + [$entry]
				elif $mode == "replace" then .[0:$at] + [$entry] + .[$at + 1:]
				else .[0:$at] + [$entry] + .[$at:]
				end
			end
		)
	' "$shell_json")" || {
		echo "Could not merge $widget_id into shell.json; leaving it alone." >&2
		continue
	}

	# Written through a temp file in the same directory: a half-written
	# shell.json is a bar that does not come up, and this runs unattended.
	tmp="$shell_json.tmp.$$"
	if ! printf '%s\n' "$merged" >"$tmp"; then
		rm -f "$tmp"
		echo "Could not write shell.json; leaving $widget_id alone." >&2
		continue
	fi
	mv -f "$tmp" "$shell_json"

	# Only after the write landed. A recorded spec whose write failed would stop
	# every later apply from retrying.
	state_put "$widget_id" "$spec"
done
