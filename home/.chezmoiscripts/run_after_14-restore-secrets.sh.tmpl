#!/bin/sh
# Derive the machine's secret files from Proton Pass.
#
# This replaced an age-encrypted blob per secret plus a passphrase-protected
# identity. The reason is non-interactive apply: unlocking the age identity
# needed a real controlling TTY, so every timer-, script- or agent-driven
# `chezmoi apply` skipped every secret and asked to be re-run by hand. A token
# has no such requirement, so an unattended apply now derives the same files an
# interactive one does.
#
# What that costs is stated plainly in the design notes: the token is a 0600
# file, so disk access alone is now enough to read the vault, where before it
# needed the YubiKey or the passphrase. That trade is the point of the change,
# not an oversight.
#
# Unlike the SSH keys — which are loaded into the agent and never written down —
# these are files that other programs open by path, so they land on disk. Each
# is fetched on every apply and rewritten only when it differs, which is what
# makes rotating a secret in the vault propagate here.
set -eu

# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC1083
has_proton={{ includeTemplate "has-proton-session" . }}
vault="Dotfiles"

# Containers get their secrets by other routes (the devpod token is passed in
# as an env file, git uses the forwarded agent) and have no pass-cli at all.
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
	exit 0
fi

# proton-ssh-load owns the login logic, including the cached token; reuse it
# rather than keeping a second copy of the same fallback chain.
# shellcheck disable=SC2154
if [ "$has_proton" != "true" ]; then
	if command -v proton-ssh-load >/dev/null 2>&1; then
		proton-ssh-load --quiet || true
	fi
	if ! pass-cli info >/dev/null 2>&1; then
		echo "[secrets] no Proton Pass session; secrets not refreshed."
		echo "[secrets] Run 'pass-cli login' or set PROTON_PASS_PERSONAL_ACCESS_TOKEN," >&2
		echo "[secrets] then 'chezmoi apply' again." >&2
		exit 0
	fi
fi

restore() {
	title="$1"
	target="$2"
	mode="$3"

	tmp="$target.tmp.$$"
	mkdir -p "$(dirname "$target")"
	chmod 700 "$(dirname "$target")" 2>/dev/null || true

	if ! (
		umask 077
		pass-cli item view --vault-name "$vault" --item-title "$title" \
			--field note >"$tmp" 2>/dev/null
	); then
		rm -f "$tmp"
		echo "[secrets] could not read '$title' from Proton Pass; leaving $(basename "$target") alone" >&2
		return 0
	fi

	# An empty fetch is a failure that exited 0 — writing it would truncate a
	# working secret, which is worse than not refreshing at all.
	if [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		echo "[secrets] '$title' came back empty; leaving $(basename "$target") alone" >&2
		return 0
	fi

	if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
		rm -f "$tmp"
		return 0
	fi

	mv "$tmp" "$target"
	chmod "$mode" "$target"
	echo "[secrets] wrote $(basename "$target")"
}

restore "sops age keys" "$HOME/.config/sops/age/keys.txt" 600
restore "gh hosts.yml" "$HOME/.config/gh/hosts.yml" 600
restore "sugarrush config" "$HOME/.config/sugarrush/config.toml" 600
restore "devpod dotfiles-env" "$HOME/.config/devpod/dotfiles-env" 600
