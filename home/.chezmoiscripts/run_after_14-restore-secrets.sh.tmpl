#!/bin/sh
# Write the file-shaped secrets from Proton Pass. Fetched every apply and
# rewritten only when changed, so rotating in the vault propagates. A failed or
# empty fetch leaves the existing file alone — stale beats truncated.
set -eu

# shellcheck disable=SC1083
is_container={{ includeTemplate "is-container" . }}
# shellcheck disable=SC1083
has_proton={{ includeTemplate "has-proton-session" . }}
# The machine's profile set, space-padded so a substring cannot pass for a
# profile. Rendered here rather than read from machine.env because this script
# is a template and can simply ask.
# shellcheck disable=SC1083,SC2140
profiles="{{ includeTemplate "profiles" . }}"
# Renders to vault="Dotfiles" or vault="Work". The two disables are both about
# reading a template as shell: SC1083 for the braces, SC2140 for the inner
# quotes, which look like three concatenated words and are one template call.
# shellcheck disable=SC1083,SC2140
vault="{{ includeTemplate "vault-name" . }}"

# Containers have no pass-cli; they get what they need by other routes.
# shellcheck disable=SC2154
if [ "$is_container" = "true" ]; then
	exit 0
fi

# proton-ssh-load owns the login logic, including the cached token. --prompt is
# what makes an interactive apply ask for the bootstrap PAT instead of quietly
# carrying on without keys; it no-ops without a tty, so CI and devpod are
# unaffected. ssh-agent.sh deliberately does not pass it.
# shellcheck disable=SC2154
if [ "$has_proton" != "true" ]; then
	if command -v proton-ssh-load >/dev/null 2>&1; then
		proton-ssh-load --quiet --prompt || true
	fi
	if ! pass-cli info >/dev/null 2>&1; then
		# All three lines are one message and go to one stream. The first
		# used to go to stdout and the other two to stderr, so anything
		# capturing them separately — a log, a pipe, a CI step — got the
		# problem without the fix or the fix without the problem.
		echo "[secrets] no Proton Pass session; secrets not refreshed." >&2
		echo "[secrets] Run 'pass-cli login' or set PROTON_PASS_PERSONAL_ACCESS_TOKEN," >&2
		echo "[secrets] then 'chezmoi apply' again." >&2
		exit 0
	fi
fi

restore() {
	title="$1"
	target="$2"
	mode="$3"
	# Optional: the one profile this item belongs to. Absent means every
	# machine restores it.
	only="${4:-}"

	if [ -n "$only" ]; then
		case " $profiles " in
		*" $only "*) ;;
		*)
			return 0
			;;
		esac
	fi

	tmp="$target.tmp.$$"

	# Guarded like every other step below, and for the same reason: the script
	# runs under `set -e`, so an unguarded failure here does not skip one
	# secret, it exits the script. This is a run_after script, so chezmoi stops
	# at that exit and every later one — host packages, devpod config — never
	# runs. A dangling symlink or a plain file where a config directory belongs
	# is enough, and neither is exotic on a machine that has been around a
	# while. One unreachable secret must cost exactly that one secret.
	if ! mkdir -p "$(dirname "$target")" 2>/dev/null; then
		echo "[secrets] could not create $(dirname "$target"); leaving $(basename "$target") alone" >&2
		return 0
	fi
	chmod 700 "$(dirname "$target")" 2>/dev/null || true

	if ! (
		umask 077
		pass-cli item view --vault-name "$vault" --item-title "$title" \
			--field note >"$tmp" 2>/dev/null
	); then
		rm -f "$tmp"
		echo "[secrets] could not read '$title' from Proton Pass; leaving $(basename "$target") alone" >&2
		return 0
	fi

	# An empty fetch is a failure that exited 0; writing it would truncate.
	if [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		echo "[secrets] '$title' came back empty; leaving $(basename "$target") alone" >&2
		return 0
	fi

	# Setting the mode is not part of writing the file, it is a separate
	# promise about the file — so it happens on both paths, not just the one
	# that rewrites. This used to live only after the `mv` below, behind the
	# unchanged-content early return, which meant a secret that had been
	# loosened (a stray chmod, a restore from a backup, an editor replacing the
	# inode) was re-tightened only if its content also happened to change. For
	# a secret that is never rotated, that is never.
	#
	# Reported but not fatal, and the reason is the whole point: this is the
	# only thing standing between a secret and the rest of the machine's users,
	# so it must not fail silently — and it must not abort the apply chain
	# either, which would cost every secret behind this one.
	set_mode() {
		chmod "$mode" "$target" ||
			echo "[secrets] could not set mode $mode on $(basename "$target")" >&2
	}

	if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
		rm -f "$tmp"
		set_mode
		return 0
	fi

	mv "$tmp" "$target"
	set_mode
	echo "[secrets] wrote $(basename "$target")"
}

# Both vaults hold these two, so both kinds of machine restore them.
restore "gh hosts.yml" "$HOME/.config/gh/hosts.yml" 600
restore "sugarrush config" "$HOME/.config/sugarrush/config.toml" 600

# A fourth field names the only profile that restores the item. The Work vault
# holds none of these three, and asking a vault for an item it has not got is
# not a harmless no-op: dotfiles-secrets-check derives what it watches from
# these same lines, so an unmarked line would have a work machine reporting
# three secrets missing every week — correctly, and uselessly.
#
# A marker rather than a template conditional around the block, because these
# lines are shell that shellcheck reads: a template action at statement position
# is a parse error to it, and the lint that would have to be silenced is the one
# that checks this file at all. (Naming the action here would not do either —
# this is a template, so the comment would be executed.)
#
# The age key is the sharp one. It is the single unreissuable secret here, it
# exists to decrypt the homelab's SOPS files, and that is personal work by
# definition — which is also why a work machine gets neither
# dotfiles-secrets-export nor the offline-copy half of the weekly check.
restore "sops age keys" "$HOME/.config/sops/age/keys.txt" 600 personal
restore "devpod dotfiles-env" "$HOME/.config/devpod/dotfiles-env" 600 personal
restore "devpod project-tokens" "$HOME/.config/devpod/project-tokens" 600 personal
