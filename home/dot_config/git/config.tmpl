# Managed by chezmoi. Machine-local settings belong in ~/.gitconfig, which git
# reads after this file.
{{ if eq (includeTemplate "is-container" .) "true" -}}
# Containers only: DevPod forwards the ssh-agent, but forwarding helps SSH
# remotes only, and project remotes are HTTPS. Without this a push inside a
# container fails with "could not read Username". On the host the gh credential
# helper already covers HTTPS.
[url "git@github.com:"]
	insteadOf = https://github.com/
{{ end -}}
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[user]
	name = Ronald Lokers
	email = {{ .email }}
{{- $signingKey := includeTemplate "signing-pubkey" . }}
{{- if $signingKey }}
	# The literal key, not a path: nothing lives in ~/.ssh, so git is told which
	# agent-held key to sign with. From .chezmoitemplates/signing-pubkey.
	signingkey = key::{{ $signingKey }}
{{- else }}
	# No signing key available. commit.gpgsign stays on, so the next commit
	# fails loudly rather than going unsigned. Fix: proton-ssh-load, re-apply.
{{- end }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = Catppuccin Mocha
[alias]
	st = status --short --branch
	lg = log --oneline --graph --decorate
	amend = commit --amend --no-edit
