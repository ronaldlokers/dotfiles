# Check that the Proton Pass path still works: every vault item readable, and
# every template naming a pass:// URI still rendering. Read-only — it fetches
# reports, it never writes a secret or applies anything.
#
# Enabled automatically by
# .chezmoiscripts/run_onchange_after_12-enable-secrets-check.sh.tmpl
[Unit]
Description=Check the Proton Pass secrets path is healthy
# No network ordering, deliberately. `After=/Wants=network-online.target` used
# to sit here and did nothing: there is no user-instance network-online.target
# (`systemctl --user list-units --all 'network-online*'` finds none — it is a
# system-manager target), so the lines were documentation of an intent the unit
# never had. A run that fires before the network is up fails, notifies, and the
# weekly timer comes round again; that is the actual behaviour, and two inert
# lines were not changing it.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/dotfiles-secrets-check
# Nine network round trips (eight vault items, one template render) with no
# per-call timeout: a stalled pass-cli would otherwise leave the unit
# `activating` forever, and the next weekly OnCalendar trigger is dropped
# while a unit of the same name is still running — so the check silently stops
# running at all, rather than just failing loudly once.
TimeoutStartSec=5min
# No SuccessExitStatus. It used to say `0 1`, on the reasoning that the
# notification is the signal and a unit failure on top of it is noise. The
# notification is a desktop toast: it is gone when you next look, it never
# appears at all when the timer fires outside a graphical login, and there is
# then nothing anywhere that says this machine's secrets went unchecked.
#
# `systemctl --user --failed` is the durable answer to "is anything wrong", and
# it was the one place this could never show up. A failed check is now a failed
# unit, which is also what makes OnFailure= usable here later if it is ever
# wanted.
