{{- /* Rendered per machine: an untagged tool installs everywhere, a gated one
       only where its profile applies. The set comes from
       .chezmoitemplates/profiles — `host personal linux` on a laptop,
       `container typescript linux` in a devcontainer. Gate only what genuinely
       does not belong: a TUI is wanted in a container as much as on a host, and
       most of this list is untagged for that reason. */ -}}
[tools]
# Omarchy declares these two lazy tools without registry aliases or binary
# metadata. The aliases below select their backends; lazy_bins keeps fresh mise
# installs from warning while creating their shims.
basecamp = { version = "latest", lazy = true, lazy_bins = ["basecamp"] }
muse = { version = "latest", lazy = true, lazy_bins = ["muse"] }
bat = "0.26.1"
chezmoi = "2.74.0"
# The one tool here deliberately not pinned, decided 10 September 2026.
#
# Everything else in this file is pinned because a version that moves under you
# is a variable in every later debugging session. Claude Code is the exception
# for the opposite reason: it ships several times a week, its releases carry the
# harness the agent sessions actually run in, and a pin means noticing months
# later that a fixed bug was never picked up.
#
# It had already lost the argument in practice. The live config on this machine
# said `latest` and this template said 2.1.261, so every `chezmoi apply` stopped
# to ask about the same line — and the answer, each time, was to keep `latest`.
# A pin nobody applies is not a pin, it is a prompt.
#
# What this costs, stated: two machines can be on different Claude Code versions
# at the same moment, and a session's behaviour is no longer reproducible from
# this file alone. `claude --version` is where that question gets answered now.
claude = "latest"
fzf = "0.74.5"
lsd = "1.2.0"
fd = "10.5.1"
lazygit = "0.66.2"
node = "26.13.0"
# mason installs pip-backed packages (ruff) into a venv; without a
# python3 on PATH those installs fail
python = "3.14.7"
ripgrep = "15.2.0"
neovim = "0.12.6"
direnv = "2.38.2"
# Shell history in SQLite; sync off, see ~/.config/atuin/config.toml.
atuin = "18.24.5"
yq = "4.54.1"
jq = "1.8.2"
delta = "0.20.1"
zoxide = "0.10.0"
# Runtime for coding agents. The mise registry entry resolves through
# `ogulcancelik/herdr`, which is a rename that redirects to `herdrdev/herdr` —
# same repository, same 25.7k stars, same creation date, verified against the
# API rather than assumed. Worth writing down because a registry name pointing
# at a different owner than the project is exactly the shape a squat would
# take, and the next person to look will have the same doubt.
herdr = "0.9.5"
gh = "2.103.3"
tmux = "3.7c"
# Picker over tmux sessions plus zoxide's frecency list. Not in the mise
# registry, so the github backend fetches the release binary.
"github:joshmedeski/sesh" = "2.34.0"
# Channel-based fuzzy finder. Takes Ctrl-T, Alt-C and the sesh picker off fzf,
# and puts every channel — git branches, k8s pods, systemd units — one
# keystroke away. fzf stays pinned regardless: fzf-tab, the zsh completion
# menu loaded from dot_zshrc, is built on it.
television = "0.15.9"
# in Arch's extra repo too, but it's a TUI — wanted inside devpod containers as
# much as on the host, so mise pins it instead of pacman. superfile sat here as
# a second file manager until an atuin-history audit showed the pair splitting
# eight invocations between them across ~1200 commands; one is enough.
yazi = "26.9.1"
# Coreutils replacements — du (dust), df (duf), top (btop), sed (sd) and a
# JSON pager (jless), plus hyperfine for benchmarking and gping for a plotted
# ping. In mise rather than the host package list for the same reason as yazi:
# a devpod container has no pacman, so anything not pinned here simply isn't
# there.
dust = "1.2.7"
duf = "0.9.1"
btop = "1.4.8"
sd = "1.1.0"
jless = "0.9.0"
hyperfine = "2.0.0"
gping = "1.21.0"
# github, not cargo: the cargo backend compiles from source and so needs a Rust
# toolchain, while this pulls the cargo-dist binary straight from the release
# and verifies its SLSA provenance. (Not `ubi:` — mise deprecated that backend
# in favour of `github:`, removal in 2027.1.0.)
"github:ronaldlokers/sugarrush" = "2026.8.3"
# rtk-ai/rtk, the CLI proxy the Claude Code PreToolUse hook routes commands
# through (dot_claude/hooks/rtk-rewrite.sh). Previously built from source by a
# run_onchange script pinned to a commit SHA, which meant no Rust toolchain, no
# rtk — so every devpod container skipped it and said so on each bootstrap.
# Upstream publishes prebuilt binaries and the registry entry resolves to
# rtk-ai/rtk, so a plain pin works everywhere and Renovate bumps it. Watch the
# name collision noted in dot_claude/CLAUDE.md: reachingforthejack/rtk is a
# different tool ("Rust Type Kit"). `rtk gain` working is the cheap check.
rtk = "1.1.0"
{{ if contains " work " (includeTemplate "profiles" .) -}}
# Jira from the terminal, on a work machine only — the first gated tool here,
# and the shape every later one follows. See docs/design-notes.md, "Profiles".
#
# ankitpokhrel/jira-cli. In mise rather than the AUR package of the same name
# for the reason every other terminal tool is: a CLI belongs to the tool list,
# where it is pinned and Renovate bumps it, and the AUR copy is a third-party
# rebuild of these same release tarballs.
"github:ankitpokhrel/jira-cli" = "1.7.0"
{{ end -}}
# General-purpose file encryption. Not used by this repo's own secrets, which
# come from Proton Pass.
age = "1.3.2"
# nvim-treesitter (main branch) shells out to the tree-sitter CLI to
# compile parsers; without it :TSUpdate fails and parsers go stale
tree-sitter = "0.27.1"
uv = "0.13.7"
# uvx_args: pomo imports typing_extensions but doesn't declare it; on
# python >=3.14 nothing pulls it in transitively anymore.
#
# Pinned to the commit v0.4.0 points at, not to the tag. A git tag is a movable
# reference: upstream can repoint it at different code and every machine picks
# that up on its next install, with the config still reading v0.4.0 and nothing
# to compare against. This is the only tool here installed straight from a git
# repo — everything else comes from a registry, where a version is immutable —
# so it is the only one where the distinction bites.
#
# The trailing comment is not decoration: Renovate's custom manager for this
# line reads the tag from it and the digest from the value, so both get bumped
# together. Editing one without the other is what the manager exists to stop.
# By hand it is:
#   git ls-remote https://github.com/mischavandenburg/pomo.git refs/tags/vX.Y.Z
"pipx:git+https://github.com/mischavandenburg/pomo.git" = { version = "865cb8f2f600282d4a0d3ee810ce4d41f701a709", uvx_args = "--with typing-extensions" } # v0.4.0
# Builds a knowledge graph of a codebase. The `/graphify` skill it ships is
# vendored into dot_claude/skills rather than left to `graphify install`, so a
# fresh machine gets it from an apply.
"pipx:graphifyy" = "0.9.102"
# Gemini's image models behind an MCP server, so Impeccable finds a
# harness-native image tool and never reaches for its OpenAI fallback. Reads
# GEMINI_API_KEY from the environment; ~/.local/bin/gemini-image-mcp is what puts
# it there, from the file restore-secrets writes.
#
# The published metadata names a homepage, repository and bug tracker at
# github.com/nano-banana/mcp-server, which does not exist. That is upstream
# sloppiness rather than a lookalike, and it was checked rather than assumed:
# the sdist's source tree is byte-identical to zhongweili/nanobanana-mcp-server
# at its last push, and 0.4.5 was uploaded 43 seconds after that push. Verify
# the same way before bumping, because the name is the only thing a lookalike
# would need.
#
# 0.4.6 now declares its compatible FastMCP range itself, so no transitive
# override is needed here.
"pipx:nanobanana-mcp-server" = "0.4.6"

# The five below were added on this machine with `mise use`, which writes
# ~/.config/mise/config.toml directly and so never reached this template. An
# apply was therefore deleting five working tools on every run, and refusing a
# non-interactive apply for exactly that reason. Recorded here so the template
# and the machine agree.
#
# `mise use` wrote them as `latest`, which this file does not do anywhere else:
# an unpinned tool resolves to a different version on every run, so the
# clean-HOME `mise run verify` job cannot be reproducible and Renovate has no
# version to bump. Pinned to what was current when they were adopted.
#
# OpenAI's agent CLI, alongside Claude Code above rather than instead of it.
codex = "0.163.0"
# Both are also pinned in this repo's own mise.toml, which is repo tooling and
# never applied into $HOME. These copies are what put them on a machine's PATH
# generally -- the versions are allowed to drift apart, since one answers "what
# does CI run" and the other "what does this machine have".
actionlint = "1.7.12"
shellcheck = "0.11.0"
# The homelab is a Kubernetes cluster whose manifests are reconciled by Flux, so
# these two are how it is reached and inspected at all.
kubectl = "1.37.2"
flux2 = "2.10.0"

[settings]
# run pipx-backend tools through uvx so no system python/pipx is needed
pipx.uvx = true

# User aliases are the supported override for system tools.
[tool_alias]
basecamp = "github:basecamp/basecamp-cli"
muse = "http:muse[url=https://api.meta.ai/muse-launcher.sh,bin=muse,version_list_url=https://api.meta.ai/muse-code/channels/muse-stable,version_json_path=.version]"
