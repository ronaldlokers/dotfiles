# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# On Omarchy machines hand interactive bash straight over to zsh — the
# same shim omarchy-setup-zsh installs (never run that; it replaces
# ~/.zshrc and ~/.bashrc, which chezmoi owns). Covers machines where
# the setup script's chsh hasn't made zsh the login shell yet.
if [ -d /usr/share/omarchy-zsh ] && command -v zsh > /dev/null; then
  if [[ $(ps --no-header --pid=$PPID --format=comm) != "zsh" && -z ${BASH_EXECUTION_STRING} && ${SHLVL} == 1 ]]; then
    shopt -q login_shell && LOGIN_OPTION='--login' || LOGIN_OPTION=''
    exec zsh $LOGIN_OPTION
  fi
fi

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    #alias grep='grep --color=auto'
    #alias fgrep='fgrep --color=auto'
    #alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
#alias ll='ls -l'
#alias la='ls -A'
#alias l='ls -CF'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
# bash theme - partly inspired by https://github.com/ohmyzsh/ohmyzsh/blob/master/themes/robbyrussell.zsh-theme
__bash_prompt() {
    local userpart='`export XIT=$? \
        && [ ! -z "${GITHUB_USER:-}" ] && echo -n "\[\033[0;32m\]@${GITHUB_USER:-} " || echo -n "\[\033[0;32m\]\u " \
        && [ "$XIT" -ne "0" ] && echo -n "\[\033[1;31m\]➜" || echo -n "\[\033[0m\]➜"`'
    local gitbranch='`\
        if [ "$(git config --get devcontainers-theme.hide-status 2>/dev/null)" != 1 ] && [ "$(git config --get codespaces-theme.hide-status 2>/dev/null)" != 1 ]; then \
            export BRANCH="$(git --no-optional-locks symbolic-ref --short HEAD 2>/dev/null || git --no-optional-locks rev-parse --short HEAD 2>/dev/null)"; \
            if [ "${BRANCH:-}" != "" ]; then \
                echo -n "\[\033[0;36m\](\[\033[1;31m\]${BRANCH:-}" \
                && if [ "$(git config --get devcontainers-theme.show-dirty 2>/dev/null)" = 1 ] && \
                    git --no-optional-locks ls-files --error-unmatch -m --directory --no-empty-directory -o --exclude-standard ":/*" > /dev/null 2>&1; then \
                        echo -n " \[\033[1;33m\]✗"; \
                fi \
                && echo -n "\[\033[0;36m\]) "; \
            fi; \
        fi`'
    local lightblue='\[\033[1;34m\]'
    local removecolor='\[\033[0m\]'
    PS1="${userpart} ${lightblue}\w ${gitbranch}${removecolor}\$ "
    unset -f __bash_prompt
}
__bash_prompt
export PROMPT_DIRTRIM=4

# Check if the terminal is xterm
if [[ "$TERM" == "xterm" ]]; then
    # These were plain `preexec`/`precmd` functions driving their own DEBUG
    # trap. bash-preexec (sourced at the end of this file, for atuin) installs
    # *its* DEBUG trap and calls anything named `preexec`, so the old shape
    # would either lose the trap or fire the title twice. Registering renamed
    # functions on bash-preexec's arrays is the supported way to do this, and
    # the arrays are plain variables — appending here, before the shim loads,
    # is fine.
    __title_preexec() {
        local cmd="$1"
        echo -ne "\033]0;${USER}@${HOSTNAME}: ${cmd}\007"
    }

    __title_precmd() {
        echo -ne "\033]0;${USER}@${HOSTNAME}: ${SHELL}\007"
    }

    preexec_functions+=(__title_preexec)
    precmd_functions+=(__title_precmd)
fi

# Ronald's Custom Additions

set -o vi

if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$($HOME/.local/bin/mise activate bash)"
elif command -v mise > /dev/null ; then
  eval "$(mise activate bash)"
fi

# fzf keybindings (fuzzy Ctrl-R etc.), same as in .zshrc, so bash
# stays usable on machines where zsh isn't the login shell yet
if command -v fzf > /dev/null ; then
  eval "$(fzf --bash)"
fi

# Syntax-highlighted, paged man pages, same as in .zshrc. `col -bx` strips
# the backspace-overstrike sequences groff emits for bold and underline,
# which bat would otherwise print literally; MANROFFOPT=-c stops newer
# groff re-introducing them.
if command -v bat > /dev/null ; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# zoxide-backed cd, same as in .zshrc. --cmd cd replaces cd outright: a
# real path still goes straight through (cd .., cd -, cd ~/x), and only an
# argument that isn't a directory falls back to frecency matching. `cdi` is
# the interactive picker, `z` the old name. Placed after the PROMPT_COMMAND
# assignment above, which zoxide's hook appends itself to.
if command -v zoxide > /dev/null ; then
  eval "$(zoxide init bash --cmd cd)"
  alias z="cd"
fi

# Aliases, kept deliberately in step with the ones in .zshrc — the two
# files have no shared alias source, so a change to one wants the same
# change here. Each is guarded on its tool, so a machine (or container)
# missing one just keeps the stock command.
#
# These come last on purpose: `ls` is already aliased to `ls --color=auto`
# by the dircolors block further up, and the later definition is the one
# that sticks.

if command -v nvim > /dev/null ; then
  alias v="nvim"
fi

if command -v git > /dev/null ; then
  alias gp="git pull"
fi

if command -v lazygit > /dev/null ; then
  alias lg="lazygit"
fi

if command -v kubectl > /dev/null ; then
  alias k="kubectl"
fi

if command -v bat > /dev/null ; then
  alias cat="bat"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -lathr'
  alias lla='ls -lgha'
  alias lt='ls --tree'
  # `tree` isn't installed anywhere here, so this fills a gap rather than
  # shadowing a real command.
  alias tree='ls --tree'
fi

# Ctrl-F opens the sesh picker, same as in .zshrc. Bound into both keymaps:
# `set -o vi` at the top of the custom section means an emacs-only binding
# would never fire.
if command -v sesh > /dev/null && command -v fzf > /dev/null ; then
  sesh-connect() {
    local session
    session="$(sesh list --icons | fzf --ansi --no-sort --prompt='sesh> ')"
    [ -z "$session" ] && return 0
    sesh connect "$session"
  }
  bind -m emacs -x '"\C-f": sesh-connect'
  bind -m vi-insert -x '"\C-f": sesh-connect'
fi

# Keep SSH_AUTH_SOCK pointing at a *live* agent — shared logic, also
# sourced by dot_zshrc. See ~/.config/shell/ssh-agent.sh.
[ -r "$HOME/.config/shell/ssh-agent.sh" ] && . "$HOME/.config/shell/ssh-agent.sh"

# Hand gh's token to the GitHub MCP server, which reads it from the
# environment. Shared logic, also sourced by dot_zshrc.
# See ~/.config/shell/github-token.sh.
[ -r "$HOME/.config/shell/github-token.sh" ] && . "$HOME/.config/shell/github-token.sh"

# bash-preexec gives bash the preexec/precmd hooks atuin needs; it is a chezmoi
# external (.chezmoiexternals/bash-preexec.toml). Guarded on the file so a shell
# still starts on a machine that hasn't applied since this change, or in a
# container where the external hasn't been fetched. Sourced this late on
# purpose: it adopts whatever PROMPT_COMMAND already holds, which by now
# includes zoxide's hook.
if [ -r "$HOME/.bash/bash-preexec.sh" ]; then
  . "$HOME/.bash/bash-preexec.sh"

  # bash-preexec rebuilds each command from `builtin history 1` rather than
  # reading it directly (that's how it feeds preexec/precmd functions their
  # argument), and that rebuild is exactly what HISTCONTROL's "ignorespace"
  # rule breaks: a line kept out of the history list is a line `history 1`
  # can't see. bash-preexec's own installer works around that the only way
  # it can — by rewriting HISTCONTROL to drop "ignorespace" entirely — and
  # it does so once, at the very first prompt it draws, before any command
  # of ours has been typed. A plain one-shot re-export placed here would
  # already be too late: it runs *before* that rewrite, not after, so it
  # gets overwritten the same way the original setting did. Re-asserting it
  # from a precmd hook — run again before every prompt, not just once — is
  # what actually restores the escape hatch: by the time the next command
  # is typed, "ignorespace" is back in effect.
  #
  # We restore *only* "ignorespace", not "ignoreboth" — deliberately
  # dropping "ignoredups". A leading-space command is kept out of the
  # history list, so a later `history 1` inside bash-preexec's DEBUG trap
  # resolves to the command *before* it, and every registered preexec
  # function (atuin's included) gets invoked a second time with that
  # stale, already-seen text. The atuin preexec guard below the atuin init
  # tells that stale replay apart from a real repeat by checking whether
  # the history number advanced — but "ignoredups" also keeps a genuinely
  # repeated command out of the history list, which advances the history
  # number exactly as little as the stale replay does. With both rules
  # active the guard cannot tell "the same command typed twice" from "a
  # spaced command's phantom re-fire of the command before it" — they look
  # identical from `history 1`'s point of view — and every real repeat
  # would silently lose its atuin entry (timestamp, duration, exit code):
  # rerunning a build, arrow-up + Enter. Dropping "ignoredups" removes that
  # ambiguity at the source: a real repeat still advances the history
  # number (it's added again, uniqued only by *not* being on the entry
  # right before it, which "ignorespace" alone doesn't touch), so the guard
  # passes it through, while a leading-space command still doesn't, so the
  # guard still catches it.
  #
  # This is a deliberate divergence from zsh's `setopt hist_ignore_dups` —
  # bash's own history list and ~/.bash_history end up with adjacent
  # duplicate lines that zsh's never would. That's acceptable specifically
  # because atuin owns Ctrl-R now: bash's history file is no longer what
  # gets searched interactively, just what bash-preexec's DEBUG trap reads
  # to identify "the command that just ran" — and atuin's own database,
  # unaffected by HISTCONTROL, is where real de-duplication would belong
  # if it mattered there.
  __bp_reassert_ignorespace() { export HISTCONTROL=ignorespace; }
  precmd_functions+=(__bp_reassert_ignorespace)
fi

# atuin owns Ctrl-R here too, same as in .zshrc — after the fzf block above,
# since whichever binds last wins. Settings are shared: ~/.config/atuin/config.toml.
#
# --disable-ai: atuin's default init also binds `?` to its account-gated AI
# TUI. In bash this lands in vi-insert (set -o vi runs earlier in this file),
# so pressing `?` at an empty prompt would launch it. This setup deliberately
# has no atuin account (see dot_config/atuin/config.toml), so that binding
# can only ever open a dead end.
if command -v atuin > /dev/null ; then
  eval "$(atuin init bash --disable-ai)"

  # atuin registers __atuin_preexec in preexec_functions (just above). The
  # HISTCONTROL precmd hook further up restores the leading-space escape
  # hatch, but bash-preexec's own trap still fires for the excluded line and
  # rebuilds "the command" with `history 1` — which, since the excluded line
  # never became a history entry, resolves to the *previous* command again.
  # Left alone, that means __atuin_preexec runs a second time with the
  # previous command's text, and atuin logs it twice. Guarding on the
  # history number actually advancing catches exactly that case: a repeat
  # firing for the same number is the stale-lookup replay, not a new
  # command, so it's dropped before it reaches atuin. This only works
  # because the hook above restores "ignorespace" and nothing else — a
  # genuinely repeated command still advances the history number, so this
  # guard passes it through rather than mistaking it for a replay.
  #
  # Guarded on __atuin_preexec existing: if a future atuin release renames
  # or restructures its hook, this whole block quietly no-ops rather than
  # erroring at shell start or, worse, swapping in a guard function that
  # calls nothing — the swap below never happens, and atuin falls back to
  # today's already-working (if occasionally double-logging) behaviour.
  if declare -F __atuin_preexec > /dev/null; then
    __atuin_preexec_guarded() {
      local histnum rest
      read -r histnum rest <<< "$(LC_ALL=C HISTTIMEFORMAT='' builtin history 1)"
      [ "$histnum" = "${__atuin_last_histnum:-}" ] && return 0
      __atuin_last_histnum=$histnum
      __atuin_preexec "$@"
    }
    preexec_functions=("${preexec_functions[@]/__atuin_preexec/__atuin_preexec_guarded}")
  fi
fi
