#!/bin/sh
# Unlock the dotfiles' age-encrypted secrets: the identity itself, then
# the SSH signing key, sops age keys, and gh token it protects. The
# identity is passphrase-protected (backed up in Proton Pass) and can only
# be unlocked with a real controlling TTY, which non-interactive apply runs
# (e.g. `devpod up`) don't have. This is a plain script, not run_once: it
# re-runs on every apply and is a fast no-op once everything is unlocked, so
# a later `chezmoi apply` from an interactive shell finishes what a
# non-interactive one had to skip.
#
# Each secret is re-derived when it's missing/empty OR when its source blob
# has changed since last time (rotation): a per-secret marker under
# $secrets_state records the sha256 of the .age source that produced the
# current plaintext. Decryption is atomic (temp file + validate non-empty +
# mv) so a wrong passphrase or interrupted run never leaves a zero-byte
# "poison" file that later runs would trust and skip forever.
set -eu

secrets_state="$HOME/.local/state/chezmoi-dotfiles/secrets"

# secret_current TARGET WANT_HASH -> true if TARGET is up to date.
# Up to date = non-empty AND (no marker yet — a legacy/first run, so trust the
# existing file and backfill the marker) OR the marker matches WANT_HASH.
secret_current() {
    [ -s "$1" ] || return 1
    _marker="$secrets_state/$(basename "$1").sha"
    [ -f "$_marker" ] || { secret_mark "$1" "$2"; return 0; }
    [ "$(cat "$_marker")" = "$2" ]
}

secret_mark() {
    mkdir -p "$secrets_state"
    printf '%s\n' "$2" > "$secrets_state/$(basename "$1").sha"
}

# decrypt_to TARGET TEMPLATE WANT_HASH: render TEMPLATE (an identity-based
# decrypt-of-include expression) to a temp file, and only promote it to TARGET
# if it succeeds and is non-empty; then record the source hash.
decrypt_to() {
    _tmp="$(mktemp)"
    # $CHEZMOI_EXECUTABLE, not bare chezmoi: during `setup` bootstrap the
    # binary runs from ./bin and isn't on PATH yet. --source is explicit (not
    # inherited) because `include` resolves relative to it.
    if "$CHEZMOI_EXECUTABLE" execute-template --source "{{ .chezmoi.sourceDir }}" --output "$_tmp" "$2" && [ -s "$_tmp" ]; then
        mv "$_tmp" "$1"
        chmod 600 "$1"
        secret_mark "$1" "$3"
    else
        rm -f "$_tmp"
        # With a terminal, every identity had its chance — the YubiKey could
        # have asked for its PIN — so a failure here is a real problem: wrong
        # identity, or a corrupt blob. Say so and stop.
        #
        # Without one, the likeliest cause is simply that the only usable
        # identity is the YubiKey and there was no way to prompt for its PIN.
        # That isn't an error, it's "not yet": leave the marker unset so the
        # secret is retried, and let the rest of the apply finish. Aborting
        # here would break `devpod up` and CI outright.
        if { true </dev/tty; } 2>/dev/null; then
            echo "error: failed to decrypt $1 (wrong age identity or corrupt blob)" >&2
            exit 1
        fi
        echo "warning: could not decrypt $1 without a TTY; skipping for now." >&2
        echo "Run 'chezmoi apply' from an interactive shell to finish." >&2
        return 0
    fi
}

key="$HOME/.config/chezmoi/key.txt"
key_hash='{{ include "key.txt.age" | sha256sum }}'

if ! secret_current "$key" "$key_hash"; then
    # /dev/tty may exist but be unopenable (no controlling terminal).
    # Test with a real open; use `true` not `exec`/`:` because redirection
    # failures on special builtins abort dash entirely.
    if { true </dev/tty; } 2>/dev/null; then
        mkdir -p "$HOME/.config/chezmoi"
        echo "Unlocking the age key that decrypts the repo's secrets (sops key," >&2
        echo "git signing key). The passphrase is backed up in Proton Pass." >&2
        _tmp="$(mktemp)"
        if "$CHEZMOI_EXECUTABLE" age decrypt --passphrase --output "$_tmp" "{{ .chezmoi.sourceDir }}/key.txt.age" && [ -s "$_tmp" ]; then
            mv "$_tmp" "$key"
            chmod 600 "$key"
            secret_mark "$key" "$key_hash"
        else
            rm -f "$_tmp"
            echo "error: failed to unlock the age identity (wrong passphrase?)" >&2
            exit 1
        fi
    else
        echo "No usable TTY, skipping age key decryption." >&2
        echo "Run 'chezmoi apply' from an interactive shell to unlock secrets." >&2
    fi
fi

# Decryption now shells out to a real age binary (the YubiKey identity is a
# plugin identity, and chezmoi's built-in age can't load plugins). Two things
# that used to be guaranteed no longer are, and decrypt_to treats any failure as
# fatal — so check them up front and skip, the way the passphrase step does.
#
#   * age itself: mise installs it, but not until run_onchange_after runs, which
#     is after this script. A fresh machine's first apply has no age at all.
#   * a TTY: the YubiKey is the first identity, so age invokes the plugin, which
#     asks for a PIN. No terminal, no PIN, no decryption.
#
# Skipping costs nothing: this is a plain run_before, so the next apply retries.
# `age --version`, not `command -v age`: a mise shim for an uninstalled tool
# sits on PATH and satisfies command -v while failing on every invocation
# ("age is not a valid shim"). Probing by running it is the same lesson the rtk
# script learned about cargo.
secrets_ready=1
if ! age --version >/dev/null 2>&1; then
    echo "No usable age binary yet, skipping secret decryption." >&2
    echo "It arrives with 'mise install'; the next 'chezmoi apply' will pick it up." >&2
    secrets_ready=0
fi
# Note there is deliberately no TTY gate here. age walks the identity list and
# falls through: with no terminal the YubiKey plugin can't ask for a PIN, but
# key.txt then decrypts anyway, so a non-interactive apply still derives every
# secret on a machine that has it. Gating on a TTY would break that. The
# YubiKey-only case — no key.txt, no terminal — is handled in decrypt_to, which
# treats a failure without a TTY as "come back later" rather than an error.

# Assemble the identity file chezmoi's [age] section points at, from whichever
# identities this machine actually has — YubiKey first so hardware is preferred,
# key.txt second as the fallback.
#
# This exists because age fails outright on an identity path that isn't there,
# rather than skipping it. Listing both paths in the config therefore breaks any
# machine with only one: containers have no yubikey-identity.txt, and a fresh
# machine has no key.txt until the passphrase step above creates it — during
# this very script. Building the file here runs after that step and before any
# decryption, so it always reflects what's actually present.
#
# Returns non-zero when there's nothing to write, which is the real "no identity
# available" signal.
yk_identity="$HOME/.config/chezmoi/yubikey-identity.txt"
identities="$HOME/.config/chezmoi/identities.txt"

build_identities() {
    mkdir -p "$HOME/.config/chezmoi"
    _tmp="$(mktemp)"
    chmod 600 "$_tmp"
    # Order is significant: age walks the file top to bottom.
    [ -f "$yk_identity" ] && cat "$yk_identity" >> "$_tmp"
    [ -f "$key" ] && cat "$key" >> "$_tmp"
    if [ -s "$_tmp" ]; then
        mv "$_tmp" "$identities"
        chmod 600 "$identities"
        return 0
    fi
    rm -f "$_tmp"
    return 1
}

if [ "$secrets_ready" -eq 1 ] && build_identities; then
    # `chezmoi age decrypt` (without --passphrase) only supports
    # passphrase-protected files, not identity-based decryption, so use the
    # `decrypt` template function instead: it reads the configured [age]
    # identities and drives the YubiKey plugin for the first of them.
    signing_key="$HOME/.ssh/id_ed25519_signing"
    signing_hash='{{ include "private_dot_ssh/private_id_ed25519_signing.age" | sha256sum }}'
    if ! secret_current "$signing_key" "$signing_hash"; then
        mkdir -p "$HOME/.ssh"
        chmod 700 "$HOME/.ssh"
        decrypt_to "$signing_key" '{{"{{"}} decrypt (include "private_dot_ssh/private_id_ed25519_signing.age") {{"}}"}}' "$signing_hash"
    fi

    sops_keys="$HOME/.config/sops/age/keys.txt"
    sops_hash='{{ include "dot_config/private_sops/private_age/private_keys.txt.age" | sha256sum }}'
    if ! secret_current "$sops_keys" "$sops_hash"; then
        mkdir -p "$HOME/.config/sops/age"
        chmod 700 "$HOME/.config/sops/age"
        decrypt_to "$sops_keys" '{{"{{"}} decrypt (include "dot_config/private_sops/private_age/private_keys.txt.age") {{"}}"}}' "$sops_hash"
    fi

    # Nightscout URL + token for the sugarrush TUI. Whole-file blob rather than
    # a template with just the token encrypted: same as gh's hosts.yml, and it
    # keeps the plaintext out of the source tree entirely.
    sugarrush_config="$HOME/.config/sugarrush/config.toml"
    sugarrush_hash='{{ include "dot_config/private_sugarrush/private_config.toml.age" | sha256sum }}'
    if ! secret_current "$sugarrush_config" "$sugarrush_hash"; then
        mkdir -p "$HOME/.config/sugarrush"
        chmod 700 "$HOME/.config/sugarrush"
        decrypt_to "$sugarrush_config" '{{"{{"}} decrypt (include "dot_config/private_sugarrush/private_config.toml.age") {{"}}"}}' "$sugarrush_hash"
    fi

    gh_hosts="$HOME/.config/gh/hosts.yml"
    gh_hash='{{ include "dot_config/private_gh/private_hosts.yml.age" | sha256sum }}'
    if ! secret_current "$gh_hosts" "$gh_hash"; then
        mkdir -p "$HOME/.config/gh"
        chmod 700 "$HOME/.config/gh"
        decrypt_to "$gh_hosts" '{{"{{"}} decrypt (include "dot_config/private_gh/private_hosts.yml.age") {{"}}"}}' "$gh_hash"
    fi
fi
