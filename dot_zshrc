# ~~~~~~~~~~~~~~~ Environment Variables ~~~~~~~~~~~~~~~~~~~~~~~~


if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

export LANG="en_US.UTF-8"

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Syntax-highlighted, paged man pages. `col -bx` strips the backspace-overstrike
# sequences groff emits for bold and underline, which bat would otherwise print
# literally; MANROFFOPT=-c stops newer groff re-introducing them.
if command -v bat > /dev/null ; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# Keep SSH_AUTH_SOCK pointing at a *live* agent — shared logic, also
# sourced by dot_bashrc. See ~/.config/shell/ssh-agent.sh.
[ -r "$HOME/.config/shell/ssh-agent.sh" ] && . "$HOME/.config/shell/ssh-agent.sh"

# Hand gh's token to the GitHub MCP server, which reads it from the
# environment. Shared logic, also sourced by dot_bashrc.
# See ~/.config/shell/github-token.sh.
[ -r "$HOME/.config/shell/github-token.sh" ] && . "$HOME/.config/shell/github-token.sh"


# ~~~~~~~~~~~~~~~ Mise ~~~~~~~~~~~~~~~~~~~~~~~~


if [ -x "$HOME/.local/bin/mise" ]; then
  eval "$($HOME/.local/bin/mise activate zsh)"
elif command -v mise > /dev/null ; then
  eval "$(mise activate zsh)"
fi

if command -v direnv > /dev/null ; then
  eval "$(direnv hook zsh)"
fi


# ~~~~~~~~~~~~~~~ Completion setup ~~~~~~~~~~~~~~~~~~~~~~~~


# fpath must be complete before compinit runs — either ours below or
# the one inside omarchy's zoptions

# pure is a chezmoi external, present on every OS
fpath+=("$HOME/.zsh/pure")

# Generated completions are cached as files in fpath; regenerating them
# with `source <(...)` on every shell start is slow. Delete a file to
# refresh it after a tool update.
mkdir -p "$HOME/.zsh/completions"
fpath+=("$HOME/.zsh/completions")

for cmd in mise kubectl; do
  # regenerate when the cache is missing *or empty*: a previous run that wrote
  # the file before the generator failed would leave a zero-byte `_cmd` that a
  # plain `[ -f ]` guard then trusts forever, poisoning fpath. Write to a temp
  # file and only promote it if the generator succeeded and produced output.
  if command -v "$cmd" > /dev/null && [ ! -s "$HOME/.zsh/completions/_$cmd" ]; then
    if "$cmd" completion zsh > "$HOME/.zsh/completions/_$cmd.tmp" 2>/dev/null &&
       [ -s "$HOME/.zsh/completions/_$cmd.tmp" ]; then
      mv "$HOME/.zsh/completions/_$cmd.tmp" "$HOME/.zsh/completions/_$cmd"
    else
      rm -f "$HOME/.zsh/completions/_$cmd.tmp"
    fi
  fi
done


# ~~~~~~~~~~~~~~~ Omarchy ~~~~~~~~~~~~~~~~~~~~~~~~


# On Omarchy machines the omarchy-zsh package ships shared shell config
# under /usr/share; source it from there so it coexists with this file.
# Never run omarchy-setup-zsh — it *replaces* ~/.zshrc and ~/.bashrc,
# which chezmoi owns. zoptions sets options, runs compinit and loads
# autosuggestions + syntax-highlighting; envs/aliases/functions add
# omarchy's aliases and helpers (tdl, format-drive, ...). shell/inits
# is deliberately skipped: mise, fzf and zoxide are set up in this file
# already, and the prompt is pure, not starship. Everything below this
# block wins where the two disagree (vi-mode, history size, ls/v).
if [ -r /usr/share/omarchy-zsh/shell/zoptions ]; then
  source /usr/share/omarchy-zsh/shell/zoptions
  source /usr/share/omarchy-zsh/shell/envs
  source /usr/share/omarchy-zsh/shell/aliases
  source /usr/share/omarchy-zsh/shell/functions
  _omarchy_zsh=1
fi


# ~~~~~~~~~~~~~~~ Completion ~~~~~~~~~~~~~~~~~~~~~~~~


# compinit's full security audit is slow; skip it (-C) unless the dump
# is older than a day. Omarchy's zoptions already ran compinit.
if [ -z "${_omarchy_zsh:-}" ]; then
  autoload -Uz compinit
  if [ -n "$(find "$HOME/.zcompdump" -mmin -1440 2>/dev/null)" ]; then
    compinit -C
  else
    compinit
  fi
fi

# fzf's own widgets are gone: atuin owns Ctrl-R, tv owns Ctrl-T and Alt-C (see
# the tv block further down), and `source <(fzf --zsh)` was left binding
# nothing. fzf itself stays — fzf-tab, the completion menu loaded at the
# bottom of this file, is built on it, though fzf-tab pipes its own
# candidates to fzf and never reads this variable. FZF_DEFAULT_COMMAND is
# kept for ad-hoc `fzf` invocations.
if command -v fzf > /dev/null && command -v fd > /dev/null ; then
  export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git"
fi

# zoxide wants to run after compinit. --cmd cd replaces cd outright rather than
# adding a `z` beside it: a real path still goes straight through (cd .., cd -,
# cd ~/x), and only an argument that isn't a directory falls back to frecency
# matching. `cdi` is the interactive picker.
#
# omarchy's aliases file defines `cd=zd`, its own near-identical wrapper. An
# alias is expanded before a function is looked up, so on a machine that has
# omarchy-zsh it would shadow the cd defined here and leave the two kinds of
# machine behaving differently. Drop it, the way the rest of this file wins
# over the omarchy block; `z` is kept as an alias so the old name still works.
if command -v zoxide > /dev/null ; then
  unalias cd 2>/dev/null
  eval "$(zoxide init zsh --cmd cd)"
  alias z="cd"
fi


# ~~~~~~~~~~~~~~~ History ~~~~~~~~~~~~~~~~~~~~~~~~


# after the omarchy block so these sizes win over its 32768
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt share_history      # share history between all shells (tmux panes)
setopt hist_ignore_dups   # don't record consecutive duplicates
setopt hist_ignore_space  # don't record commands starting with a space

# atuin is the only thing binding Ctrl-R now — the fzf block above just
# exports FZF_DEFAULT_COMMAND and binds nothing, and tv (further down) owns
# Ctrl-T and Alt-C instead. Up is atuin's directory-filtered search,
# configured in ~/.config/atuin/config.toml.
#
# The zsh options above still apply: atuin records into its own database, but
# ~/.zsh_history stays the fallback for any shell where atuin isn't installed.
#
# --disable-ai: atuin's default init also binds `?` to its account-gated AI
# TUI. This setup deliberately has no atuin account (see the local-only
# decision above), so that binding can only ever open a dead end.
if command -v atuin > /dev/null ; then
  eval "$(atuin init zsh --disable-ai)"
fi


# ~~~~~~~~~~~~~~~ Prompt ~~~~~~~~~~~~~~~~~~~~~~~~


PURE_GIT_PULL=0

autoload -U promptinit; promptinit

prompt pure


# enable zsh vi-mode; overrides omarchy's bindkey -e (its extra widget
# bindings live in the emacs keymap and stay dormant under vi-mode)
bindkey -v
export KEYTIMEOUT=1 # make switching between modes faster

# tv's pickers, bound into every keymap that is actually live: `bindkey -v`
# above means an emacs-only binding would be dead in insert mode, which is
# where these are used.
#
# `tv init zsh` is deliberately not sourced — in 0.15.9 it emits completions
# only, no bindings, so these widgets are the whole integration.
if command -v tv > /dev/null ; then
  # Ctrl-T is the channel menu: pick a channel, then pick inside it, and the
  # result lands on the command line. It is two `tv` calls rather than the
  # `channels` meta-channel because that channel's enter action runs `tv {}`
  # in execute mode, and the inner picker then writes its selection to the
  # terminal instead of back here — the command line would stay empty.
  #
  # Channels whose enter action *does* something (sesh connects, git-branch
  # checks out) print nothing, so nothing is inserted. That is correct: the
  # action already happened.
  tv-menu-widget() {
    local channel selection
    channel="$(tv list-channels | tv)" || return 0
    [ -z "$channel" ] && return 0
    selection="$(tv "$channel")" || return 0
    [ -n "$selection" ] && LBUFFER="${LBUFFER}${(q-)selection} "
    zle reset-prompt
  }

  # Alt-C changes directory in *this* shell. The dirs channel ships an
  # `[actions.cd]` running `cd {} && $SHELL`, which would strand the user in a
  # nested shell — so take the printed path and cd here instead.
  tv-dirs-widget() {
    local dir
    dir="$(tv dirs)" || return 0
    [ -z "$dir" ] && return 0
    cd "$dir" || return 0
    zle reset-prompt
  }

  # Ctrl-F is the sesh picker. Unlike the fzf pipeline it replaces, the
  # channel's own enter action runs `sesh connect`, so there is nothing to
  # capture. Ctrl-S cycles sources (all/tmux/configs/zoxide/dirs) and Ctrl-D
  # kills the highlighted session and reloads — both from the channel, which
  # is why the hand-written Ctrl-X kill binding is gone.
  tv-sesh-widget() {
    tv sesh
    zle reset-prompt
  }

  zle -N tv-menu-widget
  zle -N tv-dirs-widget
  zle -N tv-sesh-widget

  for keymap in emacs viins vicmd; do
    bindkey -M "$keymap" '^T' tv-menu-widget
    bindkey -M "$keymap" '^[c' tv-dirs-widget
    bindkey -M "$keymap" '^F' tv-sesh-widget
  done
  unset keymap
fi

# DevPod containers have no gh session — hosts.yml only decrypts with a TTY —
# so mise resolves every github:/vfox:/pipx: tool against GitHub's 60/hour
# anonymous limit and a cold bootstrap runs out partway through. This hands
# `devpod up` a file holding a no-scope PAT, which DevPod injects into the
# dotfiles install script.
#
# Wrapping the binary rather than shipping a `devpod-up` script: the flag has
# to be there every time, and DevPod has no context option to persist it. Use
# `command devpod` to bypass this.
#
# Guarded on both the subcommand and the file: `up` because no other
# subcommand accepts the flag, and readability because a machine whose age
# identity has not been unlocked has no such file and must still run devpod.
if command -v devpod > /dev/null ; then
  devpod() {
    if [ "$1" = "up" ] && [ -r "$HOME/.config/devpod/dotfiles-env" ]; then
      command devpod "$@" --dotfiles-script-env-file "$HOME/.config/devpod/dotfiles-env"
    else
      command devpod "$@"
    fi
  }
fi


# ~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~~~~~~~


# defined after omarchy's so ls/v here win over its eza/vim

if command -v nvim > /dev/null ; then
  alias v="nvim"
fi

if command -v git > /dev/null ; then
  alias gp="git pull"
fi

if command -v lazygit > /dev/null ; then
  alias lg="lazygit"
fi

if command -v kubectl > /dev/null ; then
  alias k="kubectl"
fi

if command -v bat > /dev/null ; then
  alias cat="bat"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -lathr'
  alias lla='ls -lgha'
  alias lt='ls --tree'
  # `tree` isn't installed anywhere here, so this fills a gap rather than
  # shadowing a real command — same engine as lt, under the name muscle memory
  # reaches for.
  alias tree='ls --tree'
fi


# ~~~~~~~~~~~~~~~ Plugins ~~~~~~~~~~~~~~~~~~~~~~~~


# fzf-tab wants to load after compinit but before widget-wrapping
# plugins like zsh-autosuggestions (which only wraps at the first
# prompt, so loading here is early enough even when omarchy already
# sourced it). MENU_COMPLETE (set by omarchy) bypasses fzf-tab's menu,
# so turn it off.
if command -v fzf > /dev/null && [ -f "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ]; then
  unsetopt menu_complete
  zstyle ':completion:*' menu no
  source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"
fi

# omarchy's zoptions already loads the system copies of these two;
# only source the chezmoi-external copies when it didn't
if ! typeset -f _zsh_autosuggest_start > /dev/null \
    && [ -f "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# syntax highlighting wants to be sourced last
if [ -z "${ZSH_HIGHLIGHT_VERSION:-}" ] \
    && [ -f "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

unset _omarchy_zsh
